verification/FEA-08/*.json text eol=lf
verification/FEA-08/**/*.json text eol=lf
verification/FEA-08/**/*.log text eol=lf
verification/FEA-08/**/*.md text eol=lf
verification/FEA-08/**/*.txt text eol=lf
