__pycache__/
*.py[cod]
.pytest_cache/
.venv/
build/
# V11R-PUB-1: release tooling lives in tools/build (explicitly re-included; other build/ dirs stay ignored).
!tools/build/
!tools/build/**
dist/
# Model weight guard (M2-MANGA-WEIGHTS-SOP r2): weights stay in external snapshots/installers, never in the repo — process discipline backed by ignore rules.
*.safetensors
*.pt
*.onnx

# SFX training data body (M2-SFX-DATA-INFRA): rendered PNGs / asset copies / full manifests stay out of Git; only code+schema+manifest_summary.json enter the repo.
/training_data/

# atomic_write_json 的 .bak 备份不进 Git（r2）
experiments/M2-SFX-DATA-INFRA/*.bak

# ZCode 会话本地文件不进 Git
.zcode/

# Avalonia sidecar build output (LEGACY-SHELL-ARCHIVE-1 decoupling)
/apps/desktop-avalonia/build/
# V11R-PUB-1: release tooling lives in tools/build (explicitly re-included; other build/ dirs stay ignored).
!tools/build/
!tools/build/**

# DSH local scratch (codex probe logs, temp)
/.tmp.dsh/

