{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "m2rc1-desktop",
  "version": "0.1.0",
  "identifier": "com.newmanga.m2rc1.desktop",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "M2-RC1 resource channel runtime",
        "width": 1180,
        "height": 860
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
