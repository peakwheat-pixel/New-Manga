<Project>

  <!-- Shared settings for the new C#/.NET 9 + Avalonia shell (AD-002 / ADR-0001).
       Warnings are errors here as well as on the `dotnet build -warnaserror` gate. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- The S0 single-file publish recipe deliberately accepts known trim hints (IL2026/IL2072...) from
         Avalonia/JSON call sites; trimming analysis runs across every referenced project during
         `dotnet publish -p:PublishTrimmed=true`, so the "warnings are errors" policy must step aside
         for that publish only (REL-GATE-1 / PUBLISH-FIX-1). Normal builds keep -warnaserror. -->
    <TreatWarningsAsErrors Condition="'$(PublishTrimmed)' == 'true'">false</TreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors Condition="'$(PublishTrimmed)' == 'true'">false</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>

</Project>
