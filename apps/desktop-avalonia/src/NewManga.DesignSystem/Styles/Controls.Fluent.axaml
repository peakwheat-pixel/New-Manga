<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ds="using:NewManga.DesignSystem.Controls">
  <!-- FEA-06 Fluent surface layer. All visible values resolve through the frozen Nm.* dictionary. -->
  <Style Selector="Border.fluent-top-band">
    <Setter Property="Height" Value="{DynamicResource Nm.Size.TopBand}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Panel}" />
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
  </Style>
  <Style Selector="Border.fluent-nav-rail">
    <Setter Property="Width" Value="{DynamicResource Nm.Size.TreeWidth}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Panel}" />
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
  </Style>
  <Style Selector="Border.fluent-status-band">
    <Setter Property="Height" Value="{DynamicResource Nm.Size.StatusBandPage}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Control}" />
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
  </Style>
  <Style Selector="Grid.fluent-page-host">
    <Setter Property="Margin" Value="{DynamicResource Nm.Padding.Section}" />
  </Style>
  <Style Selector="Border.fluent-overlay-host">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Panel.ZIndex" Value="{DynamicResource Nm.ZIndex.Overlay}" />
  </Style>
  <Style Selector="TextBlock.fluent-shell-brand">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Lg}" />
    <Setter Property="FontWeight" Value="{DynamicResource Nm.FontWeight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
  </Style>
  <Style Selector="Button.fluent-space-button">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Control}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
  </Style>
  <Style Selector="Button.fluent-space-button:pointerover">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Overlay}" />
  </Style>
  <Style Selector="Button.fluent-space-button:pressed">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
  </Style>
  <Style Selector="Button.fluent-space-button.selected">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>
  <Style Selector="Button.fluent-space-button:disabled">
    <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
  </Style>
  <Style Selector="Button.fluent-command-row">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Control}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
  </Style>
  <Style Selector="Button.fluent-command-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Overlay}" />
  </Style>
  <Style Selector="Button.fluent-command-row:pressed">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
  </Style>
  <Style Selector="Button.fluent-command-row:disabled">
    <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
  </Style>
  <Style Selector=".fluent-surface-card" x:SetterTargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Nm.Elevation.1}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Md}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Card}" />
  </Style>

  <Style Selector=".fluent-surface-card:pointerover" x:SetterTargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
  </Style>
  <Style Selector=".fluent-surface-card.selected" x:SetterTargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Nm.Elevation.2}" />
  </Style>
  <Style Selector=".fluent-surface-card:disabled" x:SetterTargetType="Border">
    <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
  </Style>
  <Style Selector="StackPanel.fluent-page-layout">
    <Setter Property="Spacing" Value="{DynamicResource Nm.Space.3}" />
  </Style>
  <Style Selector="StackPanel.fluent-page-toolbar">
    <Setter Property="Spacing" Value="{DynamicResource Nm.Space.2}" />
  </Style>
  <Style Selector="Border.fluent-page-surface">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Canvas}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Section}" />
  </Style>
  <Style Selector="TextBlock.fluent-page-title">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xl}" />
    <Setter Property="FontWeight" Value="{DynamicResource Nm.FontWeight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
  </Style>
  <Style Selector="Border.fluent-detail-pane">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Nm.Elevation.1}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Panel}" />
  </Style>
  <Style Selector="Border.fluent-modal-scrim">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Scrim}" />
    <Setter Property="Panel.ZIndex" Value="{DynamicResource Nm.ZIndex.Modal}" />
  </Style>
  <Style Selector="TextBlock.fluent-status-text">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.fluent-subtle-text">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Tertiary}" />
  </Style>

  <Style Selector=".fluent-dialog" x:SetterTargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Strong}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Nm.Elevation.3}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Lg}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Section}" />
    <Setter Property="Panel.ZIndex" Value="{DynamicResource Nm.ZIndex.Modal}" />
  </Style>

  <Style Selector=".fluent-book-card" x:SetterTargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Md}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Card}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector=".fluent-book-card:pointerover" x:SetterTargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Overlay}" />
  </Style>
  <Style Selector=".fluent-book-card:pressed" x:SetterTargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
  </Style>
  <Style Selector=".fluent-book-card.selected" x:SetterTargetType="Button">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
  </Style>
  <Style Selector=".fluent-book-card:disabled" x:SetterTargetType="Button">
    <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
  </Style>

  <Style Selector=".fluent-book-row" x:SetterTargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Canvas}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.RowNormal}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector=".fluent-book-row:pointerover" x:SetterTargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Overlay}" />
  </Style>
  <Style Selector=".fluent-book-row:pressed" x:SetterTargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
  </Style>
  <Style Selector=".fluent-book-row.selected" x:SetterTargetType="Button">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
  </Style>
  <Style Selector=".fluent-book-row:disabled" x:SetterTargetType="Button">
    <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
  </Style>

  <Style Selector=".fluent-chapter-list" x:SetterTargetType="StackPanel">
    <Setter Property="Spacing" Value="{DynamicResource Nm.Space.2}" />
  </Style>
  <Style Selector=".fluent-region-box" x:SetterTargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Focus}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.None}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Snug}" />
  </Style>
  <Style Selector=".fluent-region-box:pointerover" x:SetterTargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Hover}" />
  </Style>
  <Style Selector=".fluent-region-box.selected" x:SetterTargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Focus.Ring.Color}" />
  </Style>
  <Style Selector=".fluent-streaming-thumb" x:SetterTargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Snug}" />
  </Style>
  <Style Selector=".fluent-batch-matrix" x:SetterTargetType="ScrollViewer">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Panel}" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
  </Style>
  <Style Selector=".fluent-run-projection-bar" x:SetterTargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Md}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Control}" />
  </Style>
  <Style Selector=".fluent-reader-page" x:SetterTargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.None}" />
  </Style>
  <Style Selector=".fluent-reader-progress" x:SetterTargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Sm}" />
  </Style>
  <Style Selector=".fluent-progress" x:SetterTargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Sm}" />
  </Style>
  <Style Selector=".fluent-settings-group" x:SetterTargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Md}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Card}" />
  </Style>
  <Style Selector=".fluent-settings-field" x:SetterTargetType="Grid">
    <Setter Property="ColumnSpacing" Value="{DynamicResource Nm.Space.3}" />
    <Setter Property="RowSpacing" Value="{DynamicResource Nm.Space.2}" />
    <Setter Property="Margin" Value="{DynamicResource Nm.Padding.Snug}" />
  </Style>
  <Style Selector=".fluent-tab-strip" x:SetterTargetType="StackPanel">
    <Setter Property="Spacing" Value="{DynamicResource Nm.Space.2}" />
  </Style>

  <Style Selector="Button.fluent-primary">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Accent.On}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Control}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
  </Style>
  <Style Selector="Button.fluent-primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Hover}" />
  </Style>
  <Style Selector="Button.fluent-primary:pressed">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>
  <Style Selector="Button.fluent-primary:disabled">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Disabled}" />
    <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
  </Style>
  <Style Selector="Button.fluent-secondary">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Control}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
  </Style>
  <Style Selector="Button.fluent-secondary:pointerover">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Overlay}" />
  </Style>
  <Style Selector="Button.fluent-secondary:pressed">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
  </Style>
  <Style Selector="Button.fluent-secondary.selected">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Sm}" />
  </Style>
  <Style Selector="Button.fluent-secondary:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Disabled}" />
    <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
  </Style>
  <Style Selector="Button.fluent-danger">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Failed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Failed}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Control}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
  </Style>
  <Style Selector="Button.fluent-danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Failed}" />
  </Style>
  <Style Selector="Button.fluent-danger:pressed">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Status.Failed}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Bg.App}" />
  </Style>
  <Style Selector="Button.fluent-danger:disabled">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Disabled}" />
    <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
  </Style>

  <Style Selector="Button.fluent-icon">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Icon}" />
    <Setter Property="MinWidth" Value="{DynamicResource Nm.Size.ControlHeight}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
  </Style>
  <Style Selector="Button.fluent-icon:pointerover">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
  </Style>
  <Style Selector="Button.fluent-icon:pressed">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>
  <Style Selector="Button.fluent-icon:disabled">
    <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
  </Style>

  <Style Selector="Button.fluent-nav">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Control}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.fluent-nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Overlay}" />
  </Style>
  <Style Selector="Button.fluent-nav.selected">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>

  <Style Selector="ds|AlertBanner.fluent-info-bar">
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Md}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Control}" />
  </Style>

  <Style Selector="ds|Drawer.fluent-drawer">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Nm.Elevation.2}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Fluent.Lg}" />
    <Setter Property="MaxWidth" Value="{DynamicResource Nm.Size.Drawer}" />
    <Setter Property="Panel.ZIndex" Value="{DynamicResource Nm.ZIndex.Drawer}" />
  </Style>
  <Style Selector="Button.fluent-icon.checked">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>
</Styles>
