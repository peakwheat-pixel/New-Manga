<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ToggleSwitch: the Fluent template keeps its behaviour (knob animation, on/off content); the
       design system repaints the visible parts with token brushes (track/knob) and exposes the
       reduced-motion overlay through KnobTransitions duration tokens elsewhere. -->

  <Style Selector="ToggleSwitch">
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="ToggleSwitch /template/ Border#OuterBorder">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
  </Style>

  <Style Selector="ToggleSwitch /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
  </Style>

  <Style Selector="ToggleSwitch:checked /template/ Border#OuterBorder">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>

  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>

  <Style Selector="ToggleSwitch /template/ Ellipse#SwitchKnobOn">
    <Setter Property="Fill" Value="{DynamicResource Nm.Color.Accent.On}" />
  </Style>

  <Style Selector="ToggleSwitch /template/ Ellipse#SwitchKnobOff">
    <Setter Property="Fill" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>

  <Style Selector="ToggleSwitch:pointerover /template/ Border#OuterBorder">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Strong}" />
  </Style>

  <Style Selector="ToggleSwitch:disabled">
    <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- ComboBox / Select: surface skin over the Fluent template (IME, keyboard navigation, popup
       placement and virtualisation stay framework-owned). -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Control}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="ComboBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Strong}" />
  </Style>

  <Style Selector="ComboBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Focus}" />
  </Style>

  <Style Selector="ComboBox:disabled">
    <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <Style Selector="ComboBox.compact">
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeightSm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeightSm}" />
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
  </Style>

  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
  </Style>

  <Style Selector="ComboBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
  </Style>
</Styles>
