<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Text input surface (classes: search / mono / invalid). The Fluent template owns the editing
       machinery (IME, caret, selection); the design system owns every visible value, so text input
       stays IME-safe while matching the token palette. Focus shows a 2px accent ring via the border. -->

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Control}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>

  <Style Selector="TextBox:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Strong}" />
  </Style>

  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Focus}" />
  </Style>

  <Style Selector="TextBox:disabled">
    <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
  </Style>

  <Style Selector="TextBox.search">
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeightSm}" />
  </Style>

  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Data}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
  </Style>

  <Style Selector="TextBox.invalid">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Failed}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Focus}" />
  </Style>

  <Style Selector="TextBox.invalid:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Failed}" />
  </Style>

  <!-- Keyboard focus ring: a 2px accent outline drawn as a separate adorner-free border via the
       TextBox's own border only for TextBox; composite controls use PART_FocusRing. -->
  <Style Selector="TextBox:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Focus}" />
  </Style>
</Styles>
