<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- RadioButton: square 2px-radius marker (DESIGN_SYSTEM forbids radii > 3px) with an accent core
       when selected. Same hit-area rule as CheckBox. -->
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton">
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Md}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{DynamicResource Nm.Space.3}" Background="Transparent">
          <Border Name="PART_Outer"
                  Width="16" Height="16"
                  VerticalAlignment="Center"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Border Name="PART_Core"
                    Width="8" Height="8"
                    IsVisible="False"
                    CornerRadius="{DynamicResource Nm.Corner.Sm}"
                    Background="{DynamicResource Nm.Color.Accent.Base}" />
          </Border>
          <ContentPresenter Name="PART_ContentPresenter"
                            Grid.Column="1"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            VerticalContentAlignment="Center" />
        </Grid>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:checked /template/ Border#PART_Outer">
      <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Core">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_Outer">
      <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Strong}" />
    </Style>
    <Style Selector="^:pointerover:checked /template/ Border#PART_Outer">
      <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Hover}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
