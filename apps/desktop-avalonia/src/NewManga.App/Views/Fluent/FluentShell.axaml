<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NewManga.App.Views.Fluent.FluentShell"
        Title="New Manga"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Nm.Color.Bg.App}">

  <!-- FEA-06-PREREQ-2 P3/AC3: the Fluent shell skeleton. Only the shared frame the frozen design 04 §1
       defines exists here — top command band, left navigation rail (four product pages) and status band.
       The four pages themselves are FEA-06 work: each nav entry renders a placeholder until then. Every
       dimension references a design-system token (no bare 36/200/28 values). -->
  <Grid x:Name="FluentShellRoot" RowDefinitions="Auto,*,Auto">
    <!-- Top command band: Nm.Size.TopBand. -->
    <Border x:Name="FluentTopBand"
            Grid.Row="0"
            Height="{DynamicResource Nm.Size.TopBand}"
            Background="{DynamicResource Nm.Color.Bg.Raised}"
            BorderBrush="{DynamicResource Nm.Color.Line.Subtle}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="{DynamicResource Nm.Padding.Cell}">
        <TextBlock x:Name="FluentTitle"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource Nm.FontSize.Sm}"
                   FontWeight="{DynamicResource Nm.FontWeight.SemiBold}"
                   Foreground="{DynamicResource Nm.Color.Text.Primary}"
                   Text="New Manga" />
        <TextBlock x:Name="FluentFrontendLabel"
                   Grid.Column="1"
                   Margin="{DynamicResource Nm.Space.S3}"
                   VerticalAlignment="Center"
                   FontSize="{DynamicResource Nm.FontSize.Xs}"
                   Foreground="{DynamicResource Nm.Color.Text.Tertiary}"
                   Text="Fluent frontend (FEA-06)" />
      </Grid>
    </Border>

    <!-- Main row: left navigation rail (Nm.Size.TreeWidth) + page host. -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
      <Border x:Name="FluentNavRail"
              Grid.Column="0"
              Width="{DynamicResource Nm.Size.TreeWidth}"
              Background="{DynamicResource Nm.Color.Bg.Panel}"
              BorderBrush="{DynamicResource Nm.Color.Line.Subtle}"
              BorderThickness="0,0,1,0">
        <StackPanel x:Name="FluentNavItems"
                    Margin="{DynamicResource Nm.Padding.Panel}"
                    Spacing="{DynamicResource Nm.Space.S1}">
          <Button x:Name="NavLibrary"
                  AutomationProperties.Name="书架"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Content="书架" />
          <Button x:Name="NavWorkbench"
                  AutomationProperties.Name="工作台"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Content="工作台" />
          <Button x:Name="NavReader"
                  AutomationProperties.Name="阅读器"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Content="阅读器" />
          <Button x:Name="NavSettings"
                  AutomationProperties.Name="设置"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Content="设置" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Background="{DynamicResource Nm.Color.Bg.Canvas}">
        <StackPanel Margin="{DynamicResource Nm.Padding.Section}" Spacing="{DynamicResource Nm.Space.S2}">
          <TextBlock x:Name="FluentPageTitle"
                     FontSize="{DynamicResource Nm.FontSize.Lg}"
                     FontWeight="{DynamicResource Nm.FontWeight.SemiBold}"
                     Foreground="{DynamicResource Nm.Color.Text.Primary}" />
          <TextBlock x:Name="FluentPagePlaceholder"
                     FontSize="{DynamicResource Nm.FontSize.Sm}"
                     Foreground="{DynamicResource Nm.Color.Text.Secondary}"
                     TextWrapping="Wrap" />
          <TextBlock x:Name="FluentPageOwnerNote"
                     FontSize="{DynamicResource Nm.FontSize.Xs}"
                     Foreground="{DynamicResource Nm.Color.Text.Tertiary}"
                     TextWrapping="Wrap"
                     Text="页面内容由 FEA-06 实现；PREREQ-2 只交付可启动的 Fluent 壳骨架。" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Status band: Nm.Size.StatusBandPage. -->
    <Border x:Name="FluentStatusBand"
            Grid.Row="2"
            Height="{DynamicResource Nm.Size.StatusBandPage}"
            Background="{DynamicResource Nm.Color.Bg.Raised}"
            BorderBrush="{DynamicResource Nm.Color.Line.Subtle}"
            BorderThickness="0,1,0,0">
      <TextBlock x:Name="FluentStatusText"
                 Margin="{DynamicResource Nm.Padding.Cell}"
                 VerticalAlignment="Center"
                 FontSize="{DynamicResource Nm.FontSize.Xs}"
                 Foreground="{DynamicResource Nm.Color.Text.Tertiary}" />
    </Border>
  </Grid>
</Window>
