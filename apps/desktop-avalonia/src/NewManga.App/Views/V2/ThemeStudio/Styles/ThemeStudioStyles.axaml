<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ts="using:NewManga.App.Views.V2.ThemeStudio.Controls">
  <!--
    V11R-C-2 Theme Studio local styles.
    The design system already owns every standard control style and the Nm.* token dictionaries, so this
    file only adds the semantic classes this surface needs (navigation item, theme card, mini tri-view,
    preview surfaces, editor swatch, dialog chrome, drop zone). Every value is a {DynamicResource Nm.*}
    token; the only literals are 0 / 1px / Transparent (contract §2.4 exceptions). No shadow, gradient,
    blur or radius above 3px appears here (DESIGN_SYSTEM §1/§9).
  -->

  <!-- ── Navigation rail ───────────────────────────────────────────────────────────────── -->
  <Style Selector="Button.navitem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
  </Style>
  <Style Selector="Button.navitem:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
  </Style>
  <Style Selector="Button.navitem.selected /template/ Border#PART_Root">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>
  <Style Selector="Button.navitem.selected">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
  </Style>
  <Style Selector="Path.navicon">
    <Setter Property="Stroke" Value="{DynamicResource Nm.Color.Text.Secondary}" />
    <Setter Property="StrokeThickness" Value="{DynamicResource Nm.Icon.Stroke}" />
    <Setter Property="Width" Value="{DynamicResource Nm.Icon.Size}" />
    <Setter Property="Height" Value="{DynamicResource Nm.Icon.Size}" />
    <Setter Property="Stretch" Value="None" />
  </Style>
  <Style Selector="Button.navitem.selected Path.navicon">
    <Setter Property="Stroke" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>
  <Style Selector="TextBlock.dirty-marker">
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Data}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ── Theme cards ──────────────────────────────────────────────────────────────────── -->
  <Style Selector="Button.themecard">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.themecard.selected Border.card">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Focus}" />
  </Style>
  <Style Selector="Button.themecard:focus-visible /template/ Border#PART_FocusRing">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Border.mini-preview">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Cell}" />
  </Style>
  <Style Selector="TextBlock.mini-caption">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Tertiary}" />
    <Setter Property="LineHeight" Value="{DynamicResource Nm.LineHeight.Meta}" />
  </Style>
  <Style Selector="Border.mini-cover">
    <Setter Property="Width" Value="{DynamicResource Nm.Space.5}" />
    <Setter Property="Height" Value="{DynamicResource Nm.Space.7}" />
    <Setter Property="Margin" Value="0,0,2,2" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
  </Style>
  <Style Selector="Border.mini-bar">
    <Setter Property="Height" Value="{DynamicResource Nm.Space.1}" />
    <Setter Property="Width" Value="{DynamicResource Nm.Space.6}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
  </Style>
  <Style Selector="Border.mini-canvas">
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.RowPageTall}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.IconSm}" />
  </Style>
  <Style Selector="Border.mini-region">
    <Setter Property="Height" Value="{DynamicResource Nm.Space.3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
  </Style>
  <Style Selector="Border.mini-line">
    <Setter Property="Height" Value="{DynamicResource Nm.Space.1}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Opacity" Value="{DynamicResource Nm.Opacity.Disabled}" />
  </Style>

  <!-- ── Preview surfaces (real control renderings) ───────────────────────────────────── -->
  <Style Selector="Border.preview-card">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Card}" />
    <Setter Property="Margin" Value="0,0,8,8" />
    <Setter Property="Width" Value="{DynamicResource Nm.Size.FilmStripExpanded}" />
  </Style>
  <Style Selector="Border.preview-cover">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.FilmStripExpanded}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Card}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.film-item">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.IconSm}" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector="Border.film-thumb">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="Width" Value="{DynamicResource Nm.Size.FilmStripCollapsed}" />
    <Setter Property="Height" Value="{DynamicResource Nm.Size.RowPageTall}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
  </Style>
  <Style Selector="Border.page-surface">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Section}" />
  </Style>
  <Style Selector="Border.page-region">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Cell}" />
  </Style>
  <Style Selector="Border.page-region.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Focus}" />
  </Style>
  <Style Selector="Border.page-region.failed">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Failed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Failed}" />
  </Style>
  <Style Selector="Border.canvas-hint">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.IconSm}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
  </Style>
  <Style Selector="Border.reader-surface">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Section}" />
  </Style>
  <Style Selector="Border.reader-region">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Cell}" />
  </Style>

  <!-- ── Editor ───────────────────────────────────────────────────────────────────────── -->
  <Style Selector="Border.swatch">
    <Setter Property="Width" Value="{DynamicResource Nm.Icon.Size}" />
    <Setter Property="Height" Value="{DynamicResource Nm.Icon.Size}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Strong}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox.hex">
    <Setter Property="MinWidth" Value="{DynamicResource Nm.Size.FilmStripCollapsed}" />
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Data}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
  </Style>
  <Style Selector="TextBlock.contrast-value">
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Data}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.contrast-row">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Cell}" />
  </Style>
  <Style Selector="Border.contrast-row.fail">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Failed}" />
  </Style>
  <Style Selector="TextBlock.contrast-state">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
  </Style>

  <!-- ── Right rail / dialog / drop zone ──────────────────────────────────────────────── -->
  <Style Selector="Border.railblock">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Panel}" />
  </Style>
  <Style Selector="Border.dialog-scrim">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="Opacity" Value="0.82" />
  </Style>
  <Style Selector="Border.dialog-card">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Section}" />
    <Setter Property="Width" Value="{DynamicResource Nm.Size.Drawer}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.dropzone">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Hairline}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Section}" />
  </Style>
  <Style Selector="Border.dropzone.active">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderThickness" Value="{DynamicResource Nm.Border.Focus}" />
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
  </Style>
  <Style Selector="TextBlock.stub-badge">
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Data}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Inverse}" />
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Status.Blocked}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.IconSm}" />
  </Style>
  <Style Selector="TextBlock.dirty-badge">
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Data}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.dirty-badge.on">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>
  <Style Selector="Border.section-header">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Panel}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Data}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
  </Style>
</Styles>
