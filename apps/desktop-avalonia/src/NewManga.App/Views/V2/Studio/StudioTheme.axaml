<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    V11R-B-3 Studio stylesheet. Scoped to the Studio subtree (included from StudioWorkspaceView.Styles),
    so it never touches Library/Console. Every colour, font size, space, radius and size below comes
    from a frozen Nm.* token (contract §2.2) via DynamicResource — there is no raw colour, no raw font
    size, no shadow, no gradient and no blur anywhere in this file (DESIGN_SYSTEM §1 hard rules).
  -->
  <Styles.Resources>
    <!-- One Button theme for the whole Studio: no Fluent visual, flat 1px border, no shadows. -->
    <ControlTheme x:Key="StudioButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
      <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
      <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
      <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Ui}" />
      <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Strong}" />
      </Style>
      <Style Selector="^:pressed /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Overlay}" />
      </Style>
      <Style Selector="^:focus /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
        <Setter Property="BorderThickness" Value="2" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="Cursor" Value="Arrow" />
      </Style>

      <Style Selector="^.primary /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Base}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
      </Style>
      <Style Selector="^.primary">
        <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Accent.On}" />
      </Style>
      <Style Selector="^.ghost /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>
      <Style Selector="^.danger /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Failed}" />
      </Style>
      <Style Selector="^.danger">
        <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Failed}" />
      </Style>
      <Style Selector="^.icon">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{DynamicResource Nm.Size.ControlHeightSm}" />
        <Setter Property="Height" Value="{DynamicResource Nm.Size.ControlHeightSm}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
      </Style>
      <Style Selector="^.active /template/ Border#PART_Border">
        <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
      </Style>
      <Style Selector="^.active">
        <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Accent.Base}" />
      </Style>
      <Style Selector="^.studio-tab">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{DynamicResource Nm.Size.InspectorCollapsed}" />
        <Setter Property="Height" Value="{DynamicResource Nm.Size.InspectorCollapsed}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
      </Style>
      <Style Selector="^.studio-segment">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Height" Value="{DynamicResource Nm.Size.ControlHeightSm}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
      </Style>
      <Style Selector="^.studio-hud-slot">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{DynamicResource Nm.Size.HudSlot}" />
        <Setter Property="Height" Value="{DynamicResource Nm.Size.HudSlot}" />
        <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
      </Style>
      <Style Selector="^.studio-film-item">
        <Setter Property="Padding" Value="4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      </Style>
      <Style Selector="^.studio-action">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Height" Value="{DynamicResource Nm.Size.ControlHeightSm}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <!-- ============================================================ text ========== -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Ui}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.nm-body">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Md}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.nm-label">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
    <Setter Property="FontWeight" Value="{DynamicResource Nm.FontWeight.Medium}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.nm-meta">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Tertiary}" />
  </Style>
  <Style Selector="TextBlock.nm-muted">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Tertiary}" />
  </Style>
  <Style Selector="TextBlock.nm-secondary">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.nm-disabled">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Disabled}" />
  </Style>
  <Style Selector="TextBlock.nm-title">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xl}" />
    <Setter Property="FontWeight" Value="{DynamicResource Nm.FontWeight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
  </Style>
  <Style Selector="TextBlock.nm-data">
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Data}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.nm-num">
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Data}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
  </Style>
  <Style Selector="TextBlock.nm-wrap">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="TextBlock.nm-center">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>

  <!-- state symbols / labels (colour always paired with the contract glyph) -->
  <Style Selector="TextBlock.nm-state-queued">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Queued}" />
  </Style>
  <Style Selector="TextBlock.nm-state-running">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Running}" />
  </Style>
  <Style Selector="TextBlock.nm-state-done">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Done}" />
  </Style>
  <Style Selector="TextBlock.nm-state-failed">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Failed}" />
  </Style>
  <Style Selector="TextBlock.nm-state-blocked">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Blocked}" />
  </Style>
  <Style Selector="TextBlock.nm-state-stale">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Stale}" />
  </Style>
  <Style Selector="TextBlock.nm-state-skipped">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Skipped}" />
  </Style>
  <Style Selector="TextBlock.nm-state-notstarted">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Disabled}" />
  </Style>
  <Style Selector="TextBlock.nm-state-nodata">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Disabled}" />
  </Style>

  <!-- state fills (pipeline dots / matrix cells): status colour at low intensity -->
  <Style Selector="Border.nm-fill-queued">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Queued}" />
  </Style>
  <Style Selector="Border.nm-fill-running">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Running}" />
  </Style>
  <Style Selector="Border.nm-fill-done">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Done}" />
  </Style>
  <Style Selector="Border.nm-fill-failed">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Failed}" />
  </Style>
  <Style Selector="Border.nm-fill-blocked">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Blocked}" />
  </Style>
  <Style Selector="Border.nm-fill-stale">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Stale}" />
  </Style>
  <Style Selector="Border.nm-fill-skipped">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Skipped}" />
  </Style>
  <Style Selector="Border.nm-fill-notstarted">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Line.Subtle}" />
  </Style>
  <Style Selector="Border.nm-fill-nodata">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Line.Subtle}" />
  </Style>

  <!-- ============================================================ surfaces ====== -->
  <Style Selector="Border.studio-root">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.App}" />
  </Style>
  <Style Selector="Border.studio-head">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Border.studio-panel">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
  </Style>
  <Style Selector="Border.studio-sunken">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
  </Style>
  <Style Selector="Border.studio-canvas">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Canvas}" />
  </Style>
  <Style Selector=":is(Border).studio-rail">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector=":is(Border).studio-rail-right">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="Border.studio-sunken-band">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.studio-chip">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Border.studio-chip-accent">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Border.studio-divider">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Line.Default}" />
  </Style>
  <Style Selector="Border.studio-segmented">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
  </Style>

  <!-- in-place banners (error / partial / not-wired): no toast-only feedback (§9 rule 7) -->
  <Style Selector="Border.studio-banner">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Border.studio-banner-error">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Failed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Failed}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Border.studio-banner-partial">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Blocked}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Blocked}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <!-- ============================================================ canvas ======== -->
  <Style Selector=":is(Border).studio-viewport">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.studio-page-shadowless">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=":is(Border).studio-region">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector=":is(Border).studio-region.hovered">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Hover}" />
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
  </Style>
  <Style Selector=":is(Border).studio-region.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector=":is(Border).studio-region.locked">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Blocked}" />
  </Style>
  <Style Selector=":is(Border).studio-region.nogeometry">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Text.Disabled}" />
  </Style>
  <Style Selector=":is(Border).studio-region-label">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="2,0" />
  </Style>
  <Style Selector=":is(Border).studio-region-badge">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="1,0" />
  </Style>
  <Style Selector="TextBlock.studio-region-badge-failed">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Failed}" />
  </Style>
  <Style Selector="TextBlock.studio-region-badge-locked">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Blocked}" />
  </Style>
  <Style Selector="Button.studio-hud-slot">
    <Setter Property="Theme" Value="{StaticResource StudioButton}" />
  </Style>

  <!-- ============================================================ film strip ==== -->
  <Style Selector="Button.studio-film-item">
    <Setter Property="Theme" Value="{StaticResource StudioButton}" />
  </Style>
  <Style Selector="Button.studio-film-item.active /template/ Border#PART_Border">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
  </Style>
  <Style Selector="Image.studio-film-thumb">
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="Border.studio-film-placeholder">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ============================================================ hud / misc ===== -->
  <Style Selector="Border.studio-hud-ring">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.studio-track-chip">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="6,2" />
  </Style>
  <Style Selector="Border.studio-pipeline-dot">
    <Setter Property="Width" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector=":is(Border).studio-pipeline-band">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="8,0" />
  </Style>

  <!-- ============================================================ inspector ===== -->
  <Style Selector=":is(Border).studio-inspector">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector=":is(Border).studio-inspector-rail">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.studio-section">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,8" />
  </Style>
  <Style Selector="TextBlock.studio-section-title">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="FontWeight" Value="{DynamicResource Nm.FontWeight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Tertiary}" />
  </Style>
  <Style Selector="Border.studio-field">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="6,4" />
  </Style>
  <Style Selector="Border.studio-field-readonly">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>
  <Style Selector="Border.studio-revision-row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Border.studio-revision-row.selected">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>

  <!-- ============================================================ modal ======== -->
  <Style Selector="Border.studio-scrim">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="Opacity" Value="0.86" />
  </Style>
  <Style Selector="Border.studio-modal-card">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Md}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Section}" />
    <Setter Property="Width" Value="480" />
  </Style>
</Styles>
