<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NewManga.App.ViewModels.V2.Shell"
             xmlns:v="using:NewManga.App.Views.V2.Shell"
             xmlns:lv="using:NewManga.App.Views.V2.Library"
             xmlns:cn="using:NewManga.App.Views.V2.Console"
             x:Class="NewManga.App.Views.V2.Shell.V2WorkspaceHost"
             x:DataType="vm:AppShellViewModel">
  <!-- The three spaces are created ONCE and only toggled here: switching Ctrl+1/2/3 must not rebuild a
       ViewModel and must not lose selection / scroll / filters (AC2). -->
  <Grid>
    <Grid IsVisible="{Binding IsLibrarySpace}">
      <lv:LibraryView DataContext="{Binding Library}" />
    </Grid>
    <v:StudioPendingView IsVisible="{Binding IsStudioSpace}" />
    <Grid IsVisible="{Binding IsConsoleSpace}">
      <cn:ConsoleView DataContext="{Binding Console}" />
    </Grid>
  </Grid>
</UserControl>
