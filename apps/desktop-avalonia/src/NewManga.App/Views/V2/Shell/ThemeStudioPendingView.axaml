<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NewManga.App.ViewModels.V2.Shell"
             xmlns:ctrl="using:NewManga.App.Views.V2.Shell.Controls"
             x:Class="NewManga.App.Views.V2.Shell.ThemeStudioPendingView"
             x:DataType="vm:AppShellViewModel">
  <!-- Theme Studio is a full-window overlay surface (contract §6.2); the 7-section studio itself is
       V11R-C-2. V11R-B-1 only proves the surface stack + a REAL appearance switch through the merged
       DesignSystemThemeManager (dark/light token dictionaries swap without rebuilding the window). -->
  <Grid Background="{DynamicResource Nm.Color.Bg.Canvas}">
    <Grid RowDefinitions="Auto,*">
      <Border Grid.Row="0"
              Classes="topband"
              MinHeight="{DynamicResource Nm.Size.TopBand}"
              Padding="{DynamicResource Nm.Padding.ControlSm}">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Nm.Space.3}">
          <TextBlock Classes="label" Text="主题工作室" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1"
                     Classes="meta"
                     Text="全窗表面 · 保留 TopBand 返回语义（Esc 关闭）"
                     VerticalAlignment="Center" />
          <Button Grid.Column="2"
                  Classes="ghost sm"
                  Content="返回（Esc）"
                  Command="{Binding CloseThemeStudioCommand}" />
        </Grid>
      </Border>

      <Border Grid.Row="1"
              Classes="card"
              Margin="{DynamicResource Nm.Padding.Panel}"
              Padding="{DynamicResource Nm.Padding.Section}">
        <StackPanel Spacing="{DynamicResource Nm.Space.4}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm.Space.3}">
            <TextBlock Classes="title" Text="外观（真实生效）" VerticalAlignment="Center" />
            <ctrl:StatusBadge Status="Done" />
          </StackPanel>
          <TextBlock Classes="body"
                     TextWrapping="Wrap"
                     Text="深浅外观通过 NewManga.DesignSystem 的 DesignSystemThemeManager 替换令牌字典生效：窗口与控件树不重建，选择与滚动位置不丢失。" />
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm.Space.2}">
            <TextBlock Classes="meta" Text="当前外观：" VerticalAlignment="Center" />
            <TextBlock Classes="label" Text="{Binding ThemeLabel}" VerticalAlignment="Center" />
            <Button Classes="secondary sm"
                    Content="切换深浅"
                    Command="{Binding ToggleThemeCommand}" />
          </StackPanel>
          <TextBlock Classes="meta"
                     TextWrapping="Wrap"
                     Text="能力待接入：主题库 / 预览 / 我的主题 / 编辑器 / 导入导出 / 恢复默认 7 分区由 V11R-C-2（ui-shell）接续实施，此处不伪造主题数据。" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
