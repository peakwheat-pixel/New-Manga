<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NewManga.App.ViewModels.V2.Shell"
             xmlns:ctrl="using:NewManga.App.Views.V2.Shell.Controls"
             x:Class="NewManga.App.Views.V2.Shell.ConsolePendingView"
             x:DataType="vm:AppShellViewModel">
  <!-- Console 空间由 V11R-B-2（同一 Owner，下一任务卡）实现 9 分区。此占位证明外壳路由可用。 -->
  <Grid Background="{DynamicResource Nm.Color.Bg.Canvas}">
    <Border Classes="card"
            Padding="{DynamicResource Nm.Padding.Section}"
            Margin="{DynamicResource Nm.Padding.Panel}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <StackPanel Spacing="{DynamicResource Nm.Space.4}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm.Space.3}">
          <TextBlock Classes="title" Text="控制台" VerticalAlignment="Center" />
          <ctrl:StatusBadge Status="Blocked" />
        </StackPanel>
        <TextBlock Classes="body"
                   TextWrapping="Wrap"
                   Text="控制台空间（设置中心 9 分区：任务与队列 / Provider 与凭据 / 网络与代理 / 模型与设备 / 缓存与版本 / 备份与恢复 / 插件 / 诊断 / 外观）由 V11R-B-2 接续实施。" />
        <TextBlock Classes="meta"
                   TextWrapping="Wrap"
                   Text="能力待接入：本视图不展示任何伪造的 Provider / 凭据 / 缓存数据；凭据只会在 B-2 中以「已保存 / 未保存」呈现，永不回显 secret。" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
