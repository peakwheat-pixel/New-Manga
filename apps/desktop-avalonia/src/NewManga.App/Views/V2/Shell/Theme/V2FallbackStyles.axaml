<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:NewManga.App.Views.V2.Shell.Controls">
  <!--
    V11R-B-1 LOCAL FALLBACK STYLES — DELETE AFTER NewManga.DesignSystem (V11R-D-1) IS MERGED.
    Implements the frozen class vocabulary of contract §3.1 (Button/TextBox/TextBlock/Border/…) and
    the visual rules of DESIGN_SYSTEM.md (no shadow/gradient/blur, 1px hairlines, radius <= 3px,
    accent only for focus/active/selection). Every value is a {DynamicResource Nm.*} token.
  -->

  <!-- ── Typography (DESIGN_SYSTEM §3) ─────────────────────────────────────────────── -->
  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Md}" />
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Ui}" />
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.2Xl}" />
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Display}" />
    <Setter Property="FontWeight" Value="{DynamicResource Nm.FontWeight.Regular}" />
    <Setter Property="LineHeight" Value="{DynamicResource Nm.LineHeight.Tight}" />
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xl}" />
    <Setter Property="FontWeight" Value="{DynamicResource Nm.FontWeight.SemiBold}" />
    <Setter Property="LineHeight" Value="{DynamicResource Nm.LineHeight.Tight}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Lg}" />
    <Setter Property="LineHeight" Value="{DynamicResource Nm.LineHeight.Normal}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
    <Setter Property="FontWeight" Value="{DynamicResource Nm.FontWeight.Medium}" />
  </Style>
  <Style Selector="TextBlock.meta">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.data">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Data}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.num">
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Data}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>
  <Style Selector="TextBlock.tertiary">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Tertiary}" />
  </Style>
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
    <Setter Property="FontWeight" Value="{DynamicResource Nm.FontWeight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>

  <!-- ── Surfaces (five-step elevation, no shadow) ─────────────────────────────────── -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
  </Style>
  <Style Selector="Border.raised">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
  </Style>
  <Style Selector="Border.overlay">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Md}" />
  </Style>
  <Style Selector="Border.sunken">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
  </Style>
  <Style Selector="Border.hairline">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.cover">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
  </Style>

  <!-- ── Buttons (contract §3.1: primary/secondary/ghost/danger · icon · sm) ──────── -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Control}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Strong}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
  </Style>
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Accent.On}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Hover}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Active}" />
  </Style>

  <Style Selector="Button.secondary">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Failed}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Failed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Failed}" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Failed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Failed}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="{DynamicResource Nm.Size.ControlHeight}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>

  <Style Selector="Button.sm">
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeightSm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
  </Style>

  <!-- Space tabs / breadcrumb / icon buttons of the TopBand. -->
  <Style Selector="Button.spacetab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeightSm}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
  </Style>
  <Style Selector="Button.spacetab.active">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>

  <Style Selector="Button.crumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeightSm}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
  </Style>
  <Style Selector="Button.crumb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.crumb:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>

  <Style Selector="Button.chip">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeightSm}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
  </Style>
  <Style Selector="Button.chip.on">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
  </Style>
  <Style Selector="Button.chip.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Hover}" />
  </Style>

  <Style Selector="Button.bookcard">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.bookcard:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.bookcard.selected Border.card">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>

  <Style Selector="Button.detailrow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
  <Style Selector="Button.detailrow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
  </Style>
  <Style Selector="Button.detailrow.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
  </Style>
  <Style Selector="Button.detailrow.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>

  <!-- ── Inputs ───────────────────────────────────────────────────────────────────── -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Nm.Color.Accent.Muted}" />
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Accent.Base}" />
  </Style>
  <Style Selector="TextBox.search">
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Raised}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeight}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeightSm}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Sm}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.ControlSm}" />
    <Setter Property="MinHeight" Value="{DynamicResource Nm.Size.ControlHeightSm}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Accent.Muted}" />
  </Style>

  <!-- ── Shell chrome ─────────────────────────────────────────────────────────────── -->
  <Style Selector="Border.topband">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.statusband">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Border.detailpanel">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Panel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1,0,0,0" />
  </Style>
  <Style Selector="Border.librarybar">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.App}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="Opacity" Value="0.72" />
  </Style>

  <!-- ── Local controls: Kbd / StatusBadge / AlertBanner ─────────────────────────── -->
  <Style Selector="Border.kbd">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.Bg.Sunken}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Line.Default}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kbd TextBlock.kbd-text">
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Data}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>

  <Style Selector="c|StatusBadge TextBlock.symbol">
    <Setter Property="FontFamily" Value="{DynamicResource Nm.FontFamily.Data}" />
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
  </Style>
  <Style Selector="c|StatusBadge TextBlock.label">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xs}" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
  </Style>
  <Style Selector="c|StatusBadge.st-not-started TextBlock.symbol">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Disabled}" />
  </Style>
  <Style Selector="c|StatusBadge.st-queued TextBlock.symbol">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Queued}" />
  </Style>
  <Style Selector="c|StatusBadge.st-running TextBlock.symbol">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Running}" />
  </Style>
  <Style Selector="c|StatusBadge.st-done TextBlock.symbol">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Done}" />
  </Style>
  <Style Selector="c|StatusBadge.st-failed TextBlock.symbol">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Failed}" />
  </Style>
  <Style Selector="c|StatusBadge.st-blocked TextBlock.symbol">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Blocked}" />
  </Style>
  <Style Selector="c|StatusBadge.st-stale TextBlock.symbol">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Stale}" />
  </Style>
  <Style Selector="c|StatusBadge.st-skipped TextBlock.symbol">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Skipped}" />
  </Style>
  <Style Selector="c|StatusBadge.st-locked TextBlock.symbol">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Status.Blocked}" />
  </Style>

  <Style Selector="c|AlertBanner Border.alert">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Blocked}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Blocked}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Nm.Corner.Sm}" />
    <Setter Property="Padding" Value="{DynamicResource Nm.Padding.Panel}" />
  </Style>
  <Style Selector="c|AlertBanner.st-failed Border.alert">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Failed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Failed}" />
  </Style>
  <Style Selector="c|AlertBanner.st-stale Border.alert">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Stale}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Stale}" />
  </Style>
  <Style Selector="c|AlertBanner.st-done Border.alert">
    <Setter Property="Background" Value="{DynamicResource Nm.Color.StatusMuted.Done}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Nm.Color.Status.Done}" />
  </Style>
  <Style Selector="c|AlertBanner TextBlock.alert-message">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Primary}" />
  </Style>

  <Style Selector="c|EmptyState TextBlock.empty-title">
    <Setter Property="FontSize" Value="{DynamicResource Nm.FontSize.Xl}" />
    <Setter Property="FontWeight" Value="{DynamicResource Nm.FontWeight.SemiBold}" />
  </Style>
  <Style Selector="c|EmptyState TextBlock.empty-hint">
    <Setter Property="Foreground" Value="{DynamicResource Nm.Color.Text.Secondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxWidth" Value="{DynamicResource Nm.Size.Drawer}" />
  </Style>
</Styles>
