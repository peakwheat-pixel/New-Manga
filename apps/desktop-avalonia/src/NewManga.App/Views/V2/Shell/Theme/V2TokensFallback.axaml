<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">
  <!--
    V11R-B-1 LOCAL FALLBACK TOKENS — DELETE AFTER NewManga.DesignSystem (V11R-D-1) IS MERGED.
    Values are copied verbatim from doc/design/redesign-v1/40-fusion/tokens.json (FROZEN) and use the
    frozen contract key naming (§2.2). Components never embed raw colours/font sizes; they only use
    {DynamicResource Nm.*}. This dictionary only exists because the DesignSystem project has not
    merged yet; when it lands, AppShellV2 switches this ResourceInclude to the DS dictionary.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Nm.Color.Bg.Canvas" Color="#0F1012" />
      <SolidColorBrush x:Key="Nm.Color.Bg.App" Color="#141518" />
      <SolidColorBrush x:Key="Nm.Color.Bg.Panel" Color="#1A1C1F" />
      <SolidColorBrush x:Key="Nm.Color.Bg.Raised" Color="#22252A" />
      <SolidColorBrush x:Key="Nm.Color.Bg.Overlay" Color="#2A2E34" />
      <SolidColorBrush x:Key="Nm.Color.Bg.Sunken" Color="#0B0C0E" />

      <SolidColorBrush x:Key="Nm.Color.Line.Subtle" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="Nm.Color.Line.Default" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="Nm.Color.Line.Strong" Color="#29FFFFFF" />
      <SolidColorBrush x:Key="Nm.Color.Line.Grid" Color="#0AFFFFFF" />

      <SolidColorBrush x:Key="Nm.Color.Text.Primary" Color="#E9EAEC" />
      <SolidColorBrush x:Key="Nm.Color.Text.Secondary" Color="#A3A8AF" />
      <SolidColorBrush x:Key="Nm.Color.Text.Tertiary" Color="#71767D" />
      <SolidColorBrush x:Key="Nm.Color.Text.Disabled" Color="#4E5359" />
      <SolidColorBrush x:Key="Nm.Color.Text.Inverse" Color="#0F1012" />

      <SolidColorBrush x:Key="Nm.Color.Accent.Base" Color="#D9A04B" />
      <SolidColorBrush x:Key="Nm.Color.Accent.Hover" Color="#E8B264" />
      <SolidColorBrush x:Key="Nm.Color.Accent.Active" Color="#C08A34" />
      <SolidColorBrush x:Key="Nm.Color.Accent.Muted" Color="#24D9A04B" />
      <SolidColorBrush x:Key="Nm.Color.Accent.On" Color="#17181A" />
      <SolidColorBrush x:Key="Nm.Color.Accent.Ring" Color="#73D9A04B" />

      <SolidColorBrush x:Key="Nm.Color.Status.Queued" Color="#5C6169" />
      <SolidColorBrush x:Key="Nm.Color.Status.Running" Color="#5B93B8" />
      <SolidColorBrush x:Key="Nm.Color.Status.Done" Color="#6FA97D" />
      <SolidColorBrush x:Key="Nm.Color.Status.Failed" Color="#C9634F" />
      <SolidColorBrush x:Key="Nm.Color.Status.Blocked" Color="#C8903F" />
      <SolidColorBrush x:Key="Nm.Color.Status.Stale" Color="#9A8AB0" />
      <SolidColorBrush x:Key="Nm.Color.Status.Skipped" Color="#4A4F55" />

      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Queued" Color="#2E5C6169" />
      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Running" Color="#295B93B8" />
      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Done" Color="#246FA97D" />
      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Failed" Color="#29C9634F" />
      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Blocked" Color="#29C8903F" />
      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Stale" Color="#299A8AB0" />
      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Skipped" Color="#244A4F55" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Nm.Color.Bg.Canvas" Color="#F4F3F0" />
      <SolidColorBrush x:Key="Nm.Color.Bg.App" Color="#FAF9F7" />
      <SolidColorBrush x:Key="Nm.Color.Bg.Panel" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Nm.Color.Bg.Raised" Color="#F2F1EE" />
      <SolidColorBrush x:Key="Nm.Color.Bg.Overlay" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Nm.Color.Bg.Sunken" Color="#ECEAE5" />

      <SolidColorBrush x:Key="Nm.Color.Line.Subtle" Color="#0F000000" />
      <SolidColorBrush x:Key="Nm.Color.Line.Default" Color="#1C000000" />
      <SolidColorBrush x:Key="Nm.Color.Line.Strong" Color="#2E000000" />
      <SolidColorBrush x:Key="Nm.Color.Line.Grid" Color="#0D000000" />

      <SolidColorBrush x:Key="Nm.Color.Text.Primary" Color="#1C1E21" />
      <SolidColorBrush x:Key="Nm.Color.Text.Secondary" Color="#55595F" />
      <SolidColorBrush x:Key="Nm.Color.Text.Tertiary" Color="#83888F" />
      <SolidColorBrush x:Key="Nm.Color.Text.Disabled" Color="#B4B8BD" />
      <SolidColorBrush x:Key="Nm.Color.Text.Inverse" Color="#FAF9F7" />

      <SolidColorBrush x:Key="Nm.Color.Accent.Base" Color="#B4791F" />
      <SolidColorBrush x:Key="Nm.Color.Accent.Hover" Color="#9C6717" />
      <SolidColorBrush x:Key="Nm.Color.Accent.Active" Color="#8A5A12" />
      <SolidColorBrush x:Key="Nm.Color.Accent.Muted" Color="#1FB4791F" />
      <SolidColorBrush x:Key="Nm.Color.Accent.On" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Nm.Color.Accent.Ring" Color="#66B4791F" />

      <SolidColorBrush x:Key="Nm.Color.Status.Queued" Color="#6E7378" />
      <SolidColorBrush x:Key="Nm.Color.Status.Running" Color="#3D6E8E" />
      <SolidColorBrush x:Key="Nm.Color.Status.Done" Color="#3F6B4F" />
      <SolidColorBrush x:Key="Nm.Color.Status.Failed" Color="#A8462F" />
      <SolidColorBrush x:Key="Nm.Color.Status.Blocked" Color="#8A6A1F" />
      <SolidColorBrush x:Key="Nm.Color.Status.Stale" Color="#6B5E82" />
      <SolidColorBrush x:Key="Nm.Color.Status.Skipped" Color="#8A8F94" />

      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Queued" Color="#1F6E7378" />
      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Running" Color="#1F3D6E8E" />
      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Done" Color="#1F3F6B4F" />
      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Failed" Color="#1FA8462F" />
      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Blocked" Color="#1F8A6A1F" />
      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Stale" Color="#1F6B5E82" />
      <SolidColorBrush x:Key="Nm.Color.StatusMuted.Skipped" Color="#1F8A8F94" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Theme-independent tokens (contract §2.2). -->
  <FontFamily x:Key="Nm.FontFamily.Ui">Segoe UI Variable Text, Microsoft YaHei UI, Noto Sans SC</FontFamily>
  <FontFamily x:Key="Nm.FontFamily.Data">Cascadia Mono, Consolas, Noto Sans SC</FontFamily>
  <FontFamily x:Key="Nm.FontFamily.Display">Georgia, Noto Serif SC</FontFamily>

  <x:Double x:Key="Nm.FontSize.Xs">11</x:Double>
  <x:Double x:Key="Nm.FontSize.Sm">12</x:Double>
  <x:Double x:Key="Nm.FontSize.Md">13</x:Double>
  <x:Double x:Key="Nm.FontSize.Lg">14</x:Double>
  <x:Double x:Key="Nm.FontSize.Xl">18</x:Double>
  <x:Double x:Key="Nm.FontSize.2Xl">24</x:Double>

  <FontWeight x:Key="Nm.FontWeight.Regular">Regular</FontWeight>
  <FontWeight x:Key="Nm.FontWeight.Medium">Medium</FontWeight>
  <FontWeight x:Key="Nm.FontWeight.SemiBold">SemiBold</FontWeight>

  <x:Double x:Key="Nm.LineHeight.Tight">1.25</x:Double>
  <x:Double x:Key="Nm.LineHeight.Normal">1.45</x:Double>
  <x:Double x:Key="Nm.LineHeight.Loose">1.6</x:Double>

  <x:Double x:Key="Nm.Space.0">0</x:Double>
  <x:Double x:Key="Nm.Space.1">2</x:Double>
  <x:Double x:Key="Nm.Space.2">4</x:Double>
  <x:Double x:Key="Nm.Space.3">8</x:Double>
  <x:Double x:Key="Nm.Space.4">12</x:Double>
  <x:Double x:Key="Nm.Space.5">16</x:Double>
  <x:Double x:Key="Nm.Space.6">20</x:Double>
  <x:Double x:Key="Nm.Space.7">24</x:Double>
  <x:Double x:Key="Nm.Space.8">32</x:Double>

  <CornerRadius x:Key="Nm.Corner.None">0</CornerRadius>
  <CornerRadius x:Key="Nm.Corner.Sm">2</CornerRadius>
  <CornerRadius x:Key="Nm.Corner.Md">3</CornerRadius>

  <x:Double x:Key="Nm.Size.TopBand">36</x:Double>
  <x:Double x:Key="Nm.Size.StatusBandPage">28</x:Double>
  <x:Double x:Key="Nm.Size.StatusBandBatch">24</x:Double>
  <x:Double x:Key="Nm.Size.FilmStripCollapsed">56</x:Double>
  <x:Double x:Key="Nm.Size.FilmStripExpanded">200</x:Double>
  <x:Double x:Key="Nm.Size.InspectorCollapsed">40</x:Double>
  <x:Double x:Key="Nm.Size.InspectorExpanded">320</x:Double>
  <x:Double x:Key="Nm.Size.Drawer">360</x:Double>
  <x:Double x:Key="Nm.Size.RowPage">28</x:Double>
  <x:Double x:Key="Nm.Size.RowBatch">22</x:Double>
  <x:Double x:Key="Nm.Size.ControlHeight">28</x:Double>
  <x:Double x:Key="Nm.Size.ControlHeightSm">24</x:Double>

  <Thickness x:Key="Nm.Padding.Panel">12</Thickness>
  <Thickness x:Key="Nm.Padding.Card">12</Thickness>
  <Thickness x:Key="Nm.Padding.Control">8,12</Thickness>
  <Thickness x:Key="Nm.Padding.ControlSm">6,8</Thickness>
  <Thickness x:Key="Nm.Padding.Cell">8</Thickness>
  <Thickness x:Key="Nm.Padding.Section">16</Thickness>

  <sys:TimeSpan x:Key="Nm.Motion.Duration.Fast">00:00:00.0900000</sys:TimeSpan>
  <sys:TimeSpan x:Key="Nm.Motion.Duration.Normal">00:00:00.1500000</sys:TimeSpan>
  <x:Boolean x:Key="Nm.Motion.Enabled">True</x:Boolean>

  <x:Double x:Key="Nm.Icon.Size">20</x:Double>
  <x:Double x:Key="Nm.Icon.Stroke">1.25</x:Double>
</ResourceDictionary>
