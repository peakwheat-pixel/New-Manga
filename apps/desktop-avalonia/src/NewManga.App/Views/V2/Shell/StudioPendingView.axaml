<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NewManga.App.ViewModels.V2.Shell"
             xmlns:ctrl="using:NewManga.App.Views.V2.Shell.Controls"
             x:Class="NewManga.App.Views.V2.Shell.StudioPendingView"
             x:DataType="vm:AppShellViewModel">
  <!-- Studio content belongs to V11R-B-3 (Page) / V11R-B-4 (Batch), owner ui-studio. This honest pending
       surface keeps the routing, the shared selection and the mode switch testable without faking the
       workbench (AC1: no Mock pretending to be real). -->
  <Grid Background="{DynamicResource Nm.Color.Bg.Canvas}">
    <Border Classes="card"
            Padding="{DynamicResource Nm.Padding.Section}"
            Margin="{DynamicResource Nm.Padding.Panel}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
      <StackPanel Spacing="{DynamicResource Nm.Space.4}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm.Space.3}">
          <TextBlock Classes="title" Text="工位" VerticalAlignment="Center" />
          <ctrl:StatusBadge Status="Blocked" />
        </StackPanel>
        <TextBlock Classes="body"
                   TextWrapping="Wrap"
                   Text="工位空间由 V11R-B-3（Page：胶片条 / 画布 / 检查器 / HUD）与 V11R-B-4（Batch：阶段轨道 / 状态矩阵 / Run 带）接续实施，当前不在 V11R-B-1 范围内。" />
        <TextBlock Classes="meta"
                   TextWrapping="Wrap"
                   Text="外壳已就绪：Ctrl+2 进入工位、Tab 在 页面/批次 之间切换；切换空间或模式不会重建 ViewModel，也不会丢失资料柜的 selection / 滚动 / 筛选。" />
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm.Space.2}">
          <TextBlock Classes="meta" Text="当前模式：" VerticalAlignment="Center" />
          <Button Classes="chip"
                  Classes.on="{Binding IsPageMode}"
                  Content="页面模式"
                  Command="{Binding PageModeCommand}" />
          <Button Classes="chip"
                  Classes.on="{Binding IsBatchMode}"
                  Content="批次模式"
                  Command="{Binding BatchModeCommand}" />
        </StackPanel>
        <TextBlock Classes="meta"
                   TextWrapping="Wrap"
                   Text="能力待接入：Run 投影（V11R-A-2）、Region 写面（V11R-F0-1）与工位视图尚未合入，因此这里不呈现任何伪造的画布/矩阵数据。" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
