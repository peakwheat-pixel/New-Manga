<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NewManga.App.ViewModels.V2.Library"
             xmlns:ctrl="using:NewManga.App.Views.V2.Shell.Controls"
             x:Class="NewManga.App.Views.V2.Library.RecycleBinView"
             x:DataType="vm:LibraryViewModel">
  <!-- 回收站（FEA-12-UI）：单一数据源 ListTrash；不显示总数、无缩略图/内容预览（L2）；
       cursor 只在内存中回传。彻底删除 = 只读披露 → 硬勾选 + digest 绑定 → 单帧删除。
       能力缺失/只读/旧 Core 缺 current 保护集时 fail-closed，不伪造列表或成功。 -->
  <Border Background="{DynamicResource Nm.Color.Bg.Canvas}" Padding="{DynamicResource Nm.Padding.Section}">
    <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource Nm.Space.3}">
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Nm.Space.3}">
        <TextBlock Classes="title" Text="回收站" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Classes="meta"
                   Text="仅作品级 · 恢复直接执行；彻底删除需先披露并确认；列表只显示已加载条目"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{DynamicResource Nm.Space.2}">
          <Button x:Name="TrashRefreshButton"
                  Classes="ghost sm"
                  Content="刷新"
                  Command="{Binding Trash.RefreshCommand}" />
          <Button Classes="ghost sm"
                  Content="返回书架"
                  Command="{Binding CloseRecycleBinCommand}" />
        </StackPanel>
      </Grid>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="{DynamicResource Nm.Space.3}">

          <!-- 能力缺失（fail-closed：不渲染任何伪造条目） -->
          <StackPanel Spacing="{DynamicResource Nm.Space.2}" IsVisible="{Binding Trash.ShowCapabilityState}">
            <ctrl:AlertBanner Severity="Blocked"
                              Message="{Binding Trash.CapabilityMessage}" />
            <ctrl:EmptyState Title="回收站暂不可用"
                             Hint="Core/宿主未公布回收站读取能力（library.trash.read/1）。不会伪造列表，也不会执行任何写入。"
                             ActionText="返回书架"
                             ActionCommand="{Binding CloseRecycleBinCommand}" />
          </StackPanel>

          <!-- 列表失败态（保留 typed code，不当作空回收站） -->
          <StackPanel Spacing="{DynamicResource Nm.Space.2}" IsVisible="{Binding Trash.ShowErrorState}">
            <ctrl:AlertBanner Severity="Failed"
                              Message="{Binding Trash.ErrorMessage}" />
            <Button Classes="secondary sm"
                    Content="重试读取"
                    Command="{Binding Trash.RefreshCommand}" />
          </StackPanel>

          <!-- 加载态 -->
          <TextBlock Classes="meta"
                     IsVisible="{Binding Trash.IsLoading}"
                     Text="正在读取回收站…" />

          <!-- 空态：没有任何条目；不显示总数承诺 -->
          <StackPanel Spacing="{DynamicResource Nm.Space.2}" IsVisible="{Binding Trash.ShowEmptyState}">
            <ctrl:EmptyState Title="回收站是空的"
                             Hint="书架上的「移入回收站」会出现在这里；恢复直接执行，彻底删除需先披露并确认。"
                             ActionText="返回书架"
                             ActionCommand="{Binding CloseRecycleBinCommand}" />
          </StackPanel>

          <!-- Host 只读（仅 Host 写闸；能力缺失时绝不显示此假 banner） -->
          <ctrl:AlertBanner Severity="Blocked"
                            IsVisible="{Binding Trash.ShowHostReadOnlyBanner}"
                            Message="{Binding Trash.HostReadOnlyBannerText}" />

          <!-- 探测失败（CORE_UNAVAILABLE 等；独立失败态 + 重试，不冒充能力缺失） -->
          <StackPanel Spacing="{DynamicResource Nm.Space.2}" IsVisible="{Binding Trash.ShowProbeErrorState}">
            <ctrl:AlertBanner Severity="Failed"
                              Message="{Binding Trash.ProbeErrorMessage}" />
            <Button Classes="secondary sm"
                    Content="重试探测"
                    Command="{Binding Trash.RefreshCommand}" />
          </StackPanel>

          <!-- 部分能力缺失（如只缺 write/preview）：列表保持真实，附 typed 降级横幅 -->
          <ctrl:AlertBanner Severity="Blocked"
                            IsVisible="{Binding Trash.ShowCapabilityDegraded}"
                            Message="{Binding Trash.CapabilityGapMessage}" />

          <!-- 列表条目 -->
          <StackPanel Spacing="{DynamicResource Nm.Space.2}" IsVisible="{Binding Trash.ShowList}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Nm.Space.2}">
              <CheckBox IsChecked="False" IsVisible="False" />
              <TextBlock Grid.Column="1" Classes="meta" Text="{Binding Trash.LoadedCountText}" VerticalAlignment="Center" />
              <Button Grid.Column="2"
                      Classes="ghost sm"
                      Content="加载更多"
                      IsVisible="{Binding Trash.HasMore}"
                      Command="{Binding Trash.LoadMoreCommand}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Trash.Items}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TrashItemRowViewModel">
                  <Border Classes="card" Padding="{DynamicResource Nm.Padding.Card}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{DynamicResource Nm.Space.2}">
                      <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1" Spacing="{DynamicResource Nm.Space.1}">
                        <TextBlock Classes="label" Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock Classes="meta" Text="{Binding DeletedAtText}" />
                        <TextBlock Classes="meta"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Nm.Color.Status.Failed}"
                                   IsVisible="{Binding HasConflict}"
                                   Text="{Binding ConflictReasonText}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm.Space.2}">
              <Button Classes="secondary sm"
                      Content="恢复选中"
                      IsEnabled="{Binding Trash.CanRestore}"
                      Command="{Binding Trash.RestoreCommand}" />
              <Button Classes="danger sm"
                      Content="彻底删除选中（单本）"
                      IsEnabled="{Binding Trash.HasSelection}"
                      Command="{Binding RecyclePurgeCommand}" />
              <TextBlock Classes="meta" Text="{Binding Trash.SelectionSummary}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="meta"
                       TextWrapping="Wrap"
                       IsVisible="{Binding Trash.HasStatus}"
                       Text="{Binding Trash.StatusMessage}" />
          </StackPanel>

          <!-- ── 删除影响披露面板（PD-01；只读、零副作用） ──────────────────────── -->
          <Border Classes="raised"
                  Padding="{DynamicResource Nm.Padding.Card}"
                  IsVisible="{Binding Trash.IsPreviewOpen}">
            <StackPanel Spacing="{DynamicResource Nm.Space.2}">
              <TextBlock Classes="section-title" Text="{Binding Trash.PreviewTitle}" TextWrapping="Wrap" />
              <TextBlock Classes="meta"
                         TextWrapping="Wrap"
                         IsVisible="{Binding Trash.IsPreviewLoading}"
                         Text="正在以只读方式计算删除影响清单（不写库、不动文件）…" />
              <StackPanel Spacing="{DynamicResource Nm.Space.1}" IsVisible="{Binding !Trash.IsPreviewLoading}">
                <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding Trash.PreviewProtectionText}" />
                <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding Trash.PreviewCurrentText}" />
                <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding Trash.PreviewContentText}" />
                <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding Trash.PreviewSharedRefsText}" />
                <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding Trash.PreviewDigestShortText}" />
                <!-- AC4 保留项声明：只陈述既有语义，不声称原文件被删除。 -->
                <TextBlock Classes="meta"
                           TextWrapping="Wrap"
                           Text="保留项：导出文件保留；用户源文件/源目录永不移动或删除；Pipeline 历史保留；全库历史备份不清理。" />
              </StackPanel>

              <ctrl:AlertBanner Severity="Blocked"
                                IsVisible="{Binding Trash.IsPreviewBlocked}"
                                Message="{Binding Trash.PreviewBlockedReason}" />
              <ctrl:AlertBanner Severity="Failed"
                                IsVisible="{Binding Trash.HasPreviewError}"
                                Message="{Binding Trash.PreviewErrorMessage}" />
              <!-- AC4 typed failure 就地错误 + 重新预览（新预览帧，不缓存 digest）。 -->
              <Button Classes="secondary sm"
                      Content="重新预览"
                      IsVisible="{Binding Trash.HasPreviewError}"
                      Command="{Binding Trash.RetryPreviewCommand}" />

              <CheckBox Content="我理解：彻底删除后无法恢复，且应用内删除不会删除原文件"
                        IsChecked="{Binding Trash.UnderstandIrrecoverable}"
                        IsVisible="{Binding !Trash.IsPreviewLoading}" />
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm.Space.2}">
                <Button x:Name="PreviewConfirmButton"
                        Classes="danger sm"
                        Content="彻底删除"
                        IsEnabled="{Binding Trash.CanConfirmDelete}"
                        Command="{Binding Trash.ConfirmDeleteCommand}" />
                <Button x:Name="PreviewCancelButton"
                        Classes="ghost sm"
                        Content="取消"
                        Command="{Binding Trash.CancelPreviewCommand}" />
                <TextBlock Classes="meta"
                           VerticalAlignment="Center"
                           Text="{Binding Trash.DeleteResultTitle}" />
              </StackPanel>
              <TextBlock Classes="meta" TextWrapping="Wrap" Text="{Binding Trash.DeleteOutcomeText}" />
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Nm.Space.2}"
                          IsVisible="{Binding Trash.CanRetryCleanup}">
                <Button Classes="secondary sm"
                        Content="重试清理（同一 digest）"
                        Command="{Binding Trash.RetryCleanupCommand}" />
                <TextBlock Classes="meta"
                           VerticalAlignment="Center"
                           Text="重试只重发清理帧，不重新预览，也不产生新的确认。" />
              </StackPanel>
              <Button Classes="ghost sm"
                      Content="关闭结果"
                      IsVisible="{Binding Trash.HasDeleteResult}"
                      Command="{Binding Trash.CloseResultCommand}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
