<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, sans-serif" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.nm-hint">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="Border.nm-bookcard">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.nm-bookcard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Border.nm-bookcard:pointerover TextBlock.nm-hint">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Cursor" Value="Hand" />
  </Style>
</Styles>
