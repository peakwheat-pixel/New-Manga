<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- THEME-MACOS-1: font stack is a per-pack token (no font binaries ship with the app). Theme packs
       publish AppFontFamily (a parsed FontFamily); the app applies the default theme before creating the
       main window, so the Window always resolves the active pack's stack. -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
  </Style>

  <!-- V11R-D-1 (review P1): no global TextBlock Foreground here either. Text colour must flow through
       Avalonia's TextElement inheritance chain (Window -> container -> ContentPresenter -> TextBlock)
       so a primary Button's label inherits Accent.On instead of being overridden by a global style. -->

  <Style Selector="TextBlock.nm-hint">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="Border.nm-bookcard">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.nm-bookcard:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Border.nm-bookcard:pointerover TextBlock.nm-hint">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Cursor" Value="Hand" />
  </Style>
</Styles>
