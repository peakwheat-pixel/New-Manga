{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "方向 B · 校阅台（Parlor）设计令牌。DTCG 风格；浅色为母语模式，深色为夜间覆盖（$extensions.dark）。本文件是唯一令牌源，styles.css 中的 CSS 自定义属性与之逐条对应，原型内不得出现裸色值。",
  "color": {
    "$description": "纸感色板。纸来自留白与细线，不来自纹理或阴影。朱红 accent 仅用于批注 / 差异 / 需注意 / 当前行。",
    "desk": { "$type": "color", "$value": "#F1EEE7", "$extensions": { "dark": "#171614", "use": "应用底板（三栏之外的桌面色）" } },
    "paper": { "$type": "color", "$value": "#FBFAF7", "$extensions": { "dark": "#1E1D1A", "use": "工作稿纸面，主工作面" } },
    "paperAlt": { "$type": "color", "$value": "#F4F2EC", "$extensions": { "dark": "#24221F", "use": "表头 / 页眉行 / 悬停行 / 侧栏面" } },
    "paperRaised": { "$type": "color", "$value": "#FFFFFF", "$extensions": { "dark": "#2A2723", "use": "抽屉 / 命令面板 / 对话框面" } },
    "paperEdge": { "$type": "color", "$value": "#E6E1D7", "$extensions": { "dark": "#322F2A", "use": "纸边，用于分隔面的最外圈" } },
    "ink": { "$type": "color", "$value": "#1D1B18", "$extensions": { "dark": "#EDEAE4", "use": "正文与标题，永远墨黑" } },
    "ink2": { "$type": "color", "$value": "#57524A", "$extensions": { "dark": "#B0A99E", "use": "次要文字、机器译文" } },
    "ink3": { "$type": "color", "$value": "#6E675D", "$extensions": { "dark": "#8E877C", "use": "元信息、列头、序号" } },
    "lineHair": { "$type": "color", "$value": "#E9E4DA", "$extensions": { "dark": "#2A2824", "use": "行间细线（1px）" } },
    "line": { "$type": "color", "$value": "#DCD6CA", "$extensions": { "dark": "#34312C", "use": "普通分隔线" } },
    "lineStrong": { "$type": "color", "$value": "#C4BCAD", "$extensions": { "dark": "#46423B", "use": "栏界、表头下缘、重要分隔" } },
    "accent": { "$type": "color", "$value": "#A8402F", "$extensions": { "dark": "#D2705A", "use": "朱红：批注 / 差异 / 需注意 / 当前行" } },
    "accentHover": { "$type": "color", "$value": "#8E3323", "$extensions": { "dark": "#E0856F", "use": "朱红悬停 / 按下" } },
    "accentMuted": { "$type": "color", "$value": "rgba(168,64,47,0.08)", "$extensions": { "dark": "rgba(210,112,90,0.12)", "use": "当前行底色、批注块底色" } },
    "accentLine": { "$type": "color", "$value": "rgba(168,64,47,0.32)", "$extensions": { "dark": "rgba(210,112,90,0.42)", "use": "批注块描边、差异下划线" } },
    "ok": { "$type": "color", "$value": "#3F6B4F", "$extensions": { "dark": "#78A588", "use": "确认 ✓" } },
    "warn": { "$type": "color", "$value": "#8A6A1F", "$extensions": { "dark": "#C09A4C", "use": "待确认 ●" } },
    "danger": { "$type": "color", "$value": "#A8402F", "$extensions": { "dark": "#D2705A", "use": "失败 !" } },
    "info": { "$type": "color", "$value": "#3D5A7A", "$extensions": { "dark": "#8AA6C6", "use": "进行中 / 信息" } },
    "stale": { "$type": "color", "$value": "#7A6A4F", "$extensions": { "dark": "#A8977A", "use": "过期 ◌" } },
    "muted": { "$type": "color", "$value": "#857F74", "$extensions": { "dark": "#8A847A", "use": "跳过 ⊘ / 不适用" } },
    "select": { "$type": "color", "$value": "rgba(29,27,24,0.055)", "$extensions": { "dark": "rgba(237,234,228,0.06)", "use": "多选行底色" } },
    "guide": { "$type": "color", "$value": "rgba(29,27,24,0.04)", "$extensions": { "dark": "rgba(237,234,228,0.035)", "use": "装订线 / 页边导引，不透明度 ≤4%" } },
    "scrim": { "$type": "color", "$value": "rgba(29,27,24,0.20)", "$extensions": { "dark": "rgba(0,0,0,0.42)", "use": "命令面板 / 对话框的压暗层（纯色，非高斯模糊）" } },
    "artInk": { "$type": "color", "$value": "#1D1B18", "$extensions": { "dark": "#D8D3C9", "use": "自绘页面线稿墨色" } },
    "artTone": { "$type": "color", "$value": "rgba(29,27,24,0.18)", "$extensions": { "dark": "rgba(216,211,201,0.16)", "use": "自绘页面网点 / 灰阶" } },
    "artWash": { "$type": "color", "$value": "#EFEBE2", "$extensions": { "dark": "#2A2723", "use": "自绘页面底色块" } },
    "bubbleFill": { "$type": "color", "$value": "#FDFCF9", "$extensions": { "dark": "#24221E", "use": "气泡填充" } }
  },
  "font": {
    "prose": { "$type": "fontFamily", "$value": "\"Noto Serif SC\", \"Songti SC\", Georgia, serif", "$extensions": { "use": "正文 / 原文 / 译文 / 稿件标题" } },
    "ui": { "$type": "fontFamily", "$value": "\"Segoe UI Variable Text\", \"Microsoft YaHei UI\", \"Noto Sans SC\", sans-serif", "$extensions": { "use": "界面控件 / 标签 / 说明" } },
    "mono": { "$type": "fontFamily", "$value": "\"Cascadia Mono\", Consolas, monospace", "$extensions": { "use": "页码 / 序号 / 计数 / 键位 / 时间码" } }
  },
  "fontSize": {
    "$description": "6 档，相邻差 ≥1px。只有 6 档，不得新增。",
    "xs": { "$type": "dimension", "$value": "11px" },
    "sm": { "$type": "dimension", "$value": "12px" },
    "md": { "$type": "dimension", "$value": "14px" },
    "lg": { "$type": "dimension", "$value": "17px" },
    "xl": { "$type": "dimension", "$value": "22px" },
    "xxl": { "$type": "dimension", "$value": "28px" }
  },
  "lineHeight": {
    "tight": { "$type": "number", "$value": 1.35 },
    "normal": { "$type": "number", "$value": 1.6 },
    "prose": { "$type": "number", "$value": 1.75 }
  },
  "fontWeight": {
    "regular": { "$type": "number", "$value": 400 },
    "medium": { "$type": "number", "$value": 500 },
    "strong": { "$type": "number", "$value": 600 }
  },
  "space": {
    "$description": "8 阶 4 的倍数。所有内边距 / 间距必须取值于此。",
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" }
  },
  "radius": {
    "$description": "最大 4px。纸页不做圆角卡片。",
    "sm": { "$type": "dimension", "$value": "2px" },
    "md": { "$type": "dimension", "$value": "3px" },
    "lg": { "$type": "dimension", "$value": "4px" }
  },
  "rule": {
    "hair": { "$type": "dimension", "$value": "1px" },
    "current": { "$type": "dimension", "$value": "2px" },
    "select": { "$type": "dimension", "$value": "2px" },
    "iconStroke": { "$type": "dimension", "$value": "1.25px" }
  },
  "rowHeight": {
    "tree": { "$type": "dimension", "$value": "26px" },
    "pageHeader": { "$type": "dimension", "$value": "26px" },
    "normal": { "$type": "dimension", "$value": "32px", "$extensions": { "use": "账本式表格行高，硬性要求" } },
    "comfy": { "$type": "dimension", "$value": "36px" },
    "palette": { "$type": "dimension", "$value": "32px" }
  },
  "layout": {
    "treeWidth": { "$type": "dimension", "$value": "240px" },
    "marginWidth": { "$type": "dimension", "$value": "260px" },
    "canvasStrip": { "$type": "dimension", "$value": "300px" },
    "topbarHeight": { "$type": "dimension", "$value": "44px" },
    "toolbarHeight": { "$type": "dimension", "$value": "32px" },
    "bottombarHeight": { "$type": "dimension", "$value": "30px" },
    "bannerHeight": { "$type": "dimension", "$value": "34px" },
    "cursorRail": { "$type": "dimension", "$value": "22px" },
    "seqWidth": { "$type": "dimension", "$value": "46px" },
    "typeWidth": { "$type": "dimension", "$value": "56px" },
    "statusWidth": { "$type": "dimension", "$value": "112px" },
    "iconSize": { "$type": "dimension", "$value": "20px" },
    "paletteWidth": { "$type": "dimension", "$value": "620px" },
    "sheetWidth": { "$type": "dimension", "$value": "480px" },
    "statesWidth": { "$type": "dimension", "$value": "520px" },
    "dialogWidth": { "$type": "dimension", "$value": "480px" },
    "gutter": { "$type": "dimension", "$value": "20px" },
    "thumbWidth": { "$type": "dimension", "$value": "48px" },
    "thumbHeight": { "$type": "dimension", "$value": "64px" },
    "pageAspect": { "$type": "number", "$value": 1.5 }
  },
  "motion": {
    "$description": "只有状态出现 / 消失的瞬时切换，无装饰性动画。",
    "immediate": { "$type": "duration", "$value": "0ms" }
  }
}
