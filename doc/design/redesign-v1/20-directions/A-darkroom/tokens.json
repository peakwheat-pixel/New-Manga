{
  "$schema": "https://design-tokens.org/draft-01",
  "$description": "方向 A · 暗房 / Darkroom —— 唯一令牌源。styles.css 中的每个 var() 都对应本文件的 $value。原型内禁止出现未登记的裸值（唯一例外：1px 描边线宽、百分比几何数据）。",
  "meta": {
    "direction": "A · 暗房 / Darkroom",
    "version": "1.0.0",
    "baseline": "1600x1000",
    "minViewport": "1280x800",
    "defaultTheme": "dark",
    "principles": [
      "层级只靠亮度分层 + 1px 描边，无阴影（shadow 令牌被刻意移除）",
      "圆角上限 4px：实际只用 0 / 2 / 3px，不使用胶囊圆角容器",
      "强调色琥珀只用于当前焦点 / 激活 / 正在编辑 / 当前 Region 描边",
      "状态色必须与形状 + 文字共同编码，颜色永不单独承载语义"
    ]
  },

  "color": {
    "dark": {
      "$type": "color",
      "bg": {
        "canvas": { "$value": "#0F1012", "$description": "画布外的工作台面（最暗，让页面成为画面主体）" },
        "app": { "$value": "#141518", "$description": "空间底色 / 表体" },
        "panel": { "$value": "#1A1C1F", "$description": "常驻面板：顶带、胶片条、检查器、流水线带" },
        "raised": { "$value": "#22252A", "$description": "面板内的抬升层：表头、选中行、输入框底" },
        "overlay": { "$value": "#2A2E34", "$description": "浮层：命令面板、状态演示抽屉、模态" }
      },
      "line": {
        "subtle": { "$value": "rgba(255,255,255,0.06)", "$description": "行分隔 / 网格细线" },
        "default": { "$value": "rgba(255,255,255,0.10)", "$description": "面板边界" },
        "strong": { "$value": "rgba(255,255,255,0.16)", "$description": "浮层边界 / 断开的分区" }
      },
      "text": {
        "primary": { "$value": "#E9EAEC" },
        "secondary": { "$value": "#A3A8AF" },
        "tertiary": { "$value": "#71767D" },
        "inverse": { "$value": "#0F1012", "$description": "琥珀填充上的文字" }
      },
      "accent": {
        "base": { "$value": "#D9A04B", "$description": "唯一强调色：当前焦点 / 激活 / 正在编辑" },
        "hover": { "$value": "#E8B264" },
        "muted": { "$value": "rgba(217,160,75,0.14)", "$description": "仅用于 1px 描边内侧的极淡底" },
        "on": { "$value": "#17181A", "$description": "琥珀底上的文字" }
      },
      "status": {
        "ok": { "$value": "#6FA97D" },
        "warn": { "$value": "#D9A441" },
        "danger": { "$value": "#C9634F" },
        "info": { "$value": "#6C93BF" },
        "stale": { "$value": "#B08A5A" },
        "idle": { "$value": "#5C6169" },
        "okMuted": { "$value": "rgba(111,169,125,0.13)" },
        "warnMuted": { "$value": "rgba(217,164,65,0.13)" },
        "dangerMuted": { "$value": "rgba(201,99,79,0.14)" },
        "infoMuted": { "$value": "rgba(108,147,191,0.13)" },
        "staleMuted": { "$value": "rgba(176,138,90,0.14)" }
      },
      "media": {
        "pagePaper": { "$value": "#EAE7E0", "$description": "抽象漫画页纸面（页面永远是画面里最亮的元素）" },
        "pageInk": { "$value": "#1B1A18", "$description": "分格线 / 网点 / 原文字块墨色" },
        "pageInkSoft": { "$value": "rgba(27,26,24,0.34)", "$description": "网点与弱描线" },
        "bubbleFill": { "$value": "#F6F4EE" },
        "cleanFill": { "$value": "#E4E0D8", "$description": "修复轨（已抹除文字）的底色" }
      },
      "track": {
        "base": { "$value": "rgba(255,255,255,0.08)", "$description": "进度条 / 密度条底槽" },
        "fill": { "$value": "rgba(233,234,236,0.55)" }
      },
      "focus": { "ring": { "$value": "#D9A04B" } }
    },

    "light": {
      "$type": "color",
      "$description": "浅色 = 明室校样台。层级方向与深色一致：canvas 最沉、raised 最亮。",
      "bg": {
        "canvas": { "$value": "#ECEAE5" },
        "app": { "$value": "#F4F3F0" },
        "panel": { "$value": "#FBFAF8" },
        "raised": { "$value": "#FFFFFF" },
        "overlay": { "$value": "#FFFFFF" }
      },
      "line": {
        "subtle": { "$value": "rgba(0,0,0,0.06)" },
        "default": { "$value": "rgba(0,0,0,0.10)" },
        "strong": { "$value": "rgba(0,0,0,0.18)" }
      },
      "text": {
        "primary": { "$value": "#1C1E21" },
        "secondary": { "$value": "#5A5F66" },
        "tertiary": { "$value": "#8A8F96" },
        "inverse": { "$value": "#FFFFFF" }
      },
      "accent": {
        "base": { "$value": "#B07A22", "$description": "同一支琥珀，为提高白底对比度压暗（4.0:1）" },
        "hover": { "$value": "#96661A" },
        "muted": { "$value": "rgba(176,122,34,0.12)" },
        "on": { "$value": "#FFFFFF" }
      },
      "status": {
        "ok": { "$value": "#3D7A4E" },
        "warn": { "$value": "#86621C" },
        "danger": { "$value": "#A3442F" },
        "info": { "$value": "#3F6390" },
        "stale": { "$value": "#77603A" },
        "idle": { "$value": "#8A8F96" },
        "okMuted": { "$value": "rgba(61,122,78,0.10)" },
        "warnMuted": { "$value": "rgba(134,98,28,0.10)" },
        "dangerMuted": { "$value": "rgba(163,68,47,0.10)" },
        "infoMuted": { "$value": "rgba(63,99,144,0.10)" },
        "staleMuted": { "$value": "rgba(119,96,58,0.10)" }
      },
      "media": {
        "pagePaper": { "$value": "#FFFFFF" },
        "pageInk": { "$value": "#1B1A18" },
        "pageInkSoft": { "$value": "rgba(27,26,24,0.30)" },
        "bubbleFill": { "$value": "#FFFFFF" },
        "cleanFill": { "$value": "#F0EEE9" }
      },
      "track": {
        "base": { "$value": "rgba(0,0,0,0.08)" },
        "fill": { "$value": "rgba(28,30,33,0.55)" }
      },
      "focus": { "ring": { "$value": "#B07A22" } }
    }
  },

  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "上限 4px。无 lg / pill 令牌：胶囊形容器会产生塑料感，状态胶囊改用 2px 矩形。",
    "none": { "$value": "0px" },
    "sm": { "$value": "2px" },
    "md": { "$value": "3px" }
  },

  "border": {
    "$type": "dimension",
    "hair": { "$value": "1px", "$description": "唯一允许的裸值：描边线宽" }
  },

  "font": {
    "$type": "fontFamily",
    "ui": { "$value": "\"Segoe UI Variable Text\", \"Microsoft YaHei UI\", \"Noto Sans SC\", sans-serif" },
    "data": { "$value": "\"Cascadia Mono\", Consolas, monospace" },
    "display": { "$value": "Georgia, \"Noto Serif SC\", serif" }
  },

  "fontSize": {
    "$type": "dimension",
    "$description": "6 档，相邻差 ≥1px。xs=11 / sm=12 / md=13 / lg=14 / xl=18 / 2xl=24",
    "xs": { "$value": "11px" },
    "sm": { "$value": "12px" },
    "md": { "$value": "13px" },
    "lg": { "$value": "14px" },
    "xl": { "$value": "18px" },
    "2xl": { "$value": "24px" }
  },

  "fontWeight": {
    "$type": "fontWeight",
    "$description": "3 档",
    "normal": { "$value": "400" },
    "medium": { "$value": "600" },
    "bold": { "$value": "700" }
  },

  "lineHeight": {
    "$type": "number",
    "tight": { "$value": "1.3" },
    "normal": { "$value": "1.45" },
    "loose": { "$value": "1.6" }
  },

  "rowHeight": {
    "$type": "dimension",
    "$description": "列表行 26–28px（dense=24 仅用于页网格/清单）",
    "dense": { "$value": "24px" },
    "normal": { "$value": "28px" },
    "comfy": { "$value": "34px" }
  },

  "layout": {
    "$type": "dimension",
    "$description": "基准 1600×1000。全部为弹性布局中的固定脊柱尺寸，不做固定画布。",
    "topbandHeight": { "$value": "36px" },
    "subbarHeight": { "$value": "32px" },
    "filmStripCollapsed": { "$value": "56px" },
    "filmStripExpanded": { "$value": "200px" },
    "inspectorCollapsed": { "$value": "40px" },
    "inspectorExpanded": { "$value": "320px" },
    "panelCollapsed": { "$value": "28px" },
    "panelExpanded": { "$value": "240px" },
    "consoleIndexWidth": { "$value": "200px" },
    "filmThumbWidth": { "$value": "44px" },
    "filmThumbHeight": { "$value": "56px" },
    "hudSlot": { "$value": "22px" },
    "hudOffset": { "$value": "10px" },
    "iconSize": { "$value": "24px" },
    "iconGrid": { "$value": "20px" },
    "iconStroke": { "$value": "1.25" },
    "hairline": { "$value": "1px" }
  },

  "motion": {
    "$type": "duration",
    "$description": "只有状态反馈。无入场动画、无位移、无循环动画。",
    "instant": { "$value": "0ms" },
    "fast": { "$value": "90ms" }
  },

  "shadow": {
    "$description": "刻意不提供任何阴影令牌。层级由 bg→panel→raised→overlay 的亮度差 + 1px 描边建立。",
    "$value": null
  }
}
