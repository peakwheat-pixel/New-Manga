# Keep only canonical attempt logs, manifests, and UI screenshots.
/*.log
!cargo-build-custom-protocol.log
!cargo-build.log
!core-suite.log
!final-app.stderr.log
!frontend-build.log
!partial-state-runtime-final6-run.log
!real-startup-final-run.log
!runtime-binding-final-run.log

/*.json
!evidence-manifest.json
# r197: resource-manifest.json is the resource closeout artefact every
# closed task references. The line above allowed only evidence-manifest.json,
# so this task's own manifest could never be committed - which is why its
# Resource Manifest row pointed at a file that no checkout would ever contain.
!resource-manifest.json
!partial-state-runtime-final6.json
!real-startup-final.json
!real-startup-launch-final.json
!runtime-binding-final.json

/*.png
!ui-bookshelf-real-window.png
!ui-reader-real-window.png
!ui-settings-real-window.png
!ui-workbench-real-window.png

/real_startup.mjs
