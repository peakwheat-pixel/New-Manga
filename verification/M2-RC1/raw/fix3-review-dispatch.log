ctly 256 MiB) and oversize (+1) as sparse files\n49:     boundary = derived / \"boundary.bin\"\n50:     with open(boundary, \"wb\") as handle:\n51:         handle.truncate(BOUNDARY_BYTES)\n52:     oversize = derived / \"oversize.bin\"\n53:     with open(oversize, \"wb\") as handle:\n54:         handle.truncate(BOUNDARY_BYTES + 1)\n55: \n56:     manifest = {\n57:         \"lab\": str(LAB),\n58:         \"fixtures\": {\n59:             \"asset\": {\"sha256\": sha256_hex(payload), \"bytes\": len(payload)},\n60:             \"typical\": {\"sha256\": sha256_hex(typical), \"bytes\": len(typical)},\n61:             \"boundary\": {\"sha256\": hashlib.sha256(b\"\\x00\" * BOUNDARY_BYTES).hexdigest(), \"bytes\": BOUNDARY_BYTES},\n62:         },\n63:     }\n64:     (LAB / \"fixtures.json\").write_text(json.dumps(manifest, indent=2), encoding=\"utf-8\")\n65:     print(f\"lab ready: {LAB}\")\n66:     print(f\"asset sha256: {manifest['fixtures']['asset']['sha256']}\")\n67:     return manifest\n68: \n69: \n70: def run_probe(exe: Path, manifest: dict) -> tuple[int, Path | None, float]:\n71:     out_path = LAB / \"probe-results.json\"\n72:     log_path = LAB / \"probe-runtime.log\"\n73:     udd = LAB / \"webview2-udd\"\n74:     shutil.rmtree(udd, ignore_errors=True)\n75:     for path in (out_path, log_path):\n76:         if path.exists():\n77:             path.unlink()\n78: \n79:     env = {\n80:         **os.environ,\n81:         \"M2RC1_PYTHON\": sys.executable,\n82:         \"M2RC1_SRC_ROOT\": str(REPO_ROOT / \"src\"),\n83:         \"M2RC1_DERIVED_ROOT\": str(LAB / \"scope\" / \"derived\"),\n84:         \"M2RC1_MANAGED_ROOT\": str(LAB / \"scope\" / \"managed\"),\n85:         \"M2RC1_FIXTURES\": str(LAB / \"fixtures.json\"),\n86:         \"M2RC1_PROBE_OUT\": str(out_path),\n87:         \"M2RC1_PROBE_LOG\": str(log_path),\n88:         \"WEBVIEW2_USER_DATA_FOLDER\": str(udd),\n89:     }\n90:     start = time.time()\n91:     proc = subprocess.Popen(\n92:         [str(exe)], env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT\n93:     )\n94:     output = b\"\"\n95:     try:\n96:         output, _ = proc.communicate(timeout=300)\n97:     except subprocess.TimeoutExpired:\n98:         proc.kill()\n99:         # still collect whatever stderr/stdout the window produced\n100:         try:\n101:             output, _ = proc.communicate(timeout=15)\n102:         except (subprocess.TimeoutExpired, ValueError):\n103:             pass\n104:         print(\"TIMEOUT: probe did not exit within 300 s (partial output below)\")\n105:     elapsed = time.time() - start\n106:     if output:\n107:         log_path.write_bytes(output)\n108:         tail = output.decode(\"utf-8\", errors=\"replace\").splitlines()\n109:         for line in tail[-25:]:\n110:             print(\"  [runtime]\", line)\n111:     print(f\"exit_code={proc.returncode} elapsed={elapsed:.1f}s\")\n112:     return proc.returncode, out_path if out_path.exists() else None, elapsed\n113: \n114: \n115: def main() -> int:\n116:     parser = argparse.ArgumentParser()\n117:     parser.add_argument(\n118:         \"--exe\",\n119:         default=str(\n120:             REPO_ROOT / \"apps\" / \"desktop\" / \"src-tauri\" / \"target\" / \"release\" / \"m2rc1-desktop.exe\"\n121:         ),\n122:     )\n123:     args = parser.parse_args()\n124: \n125:     exe = Path(args.exe)\n126:     if not exe.exists():\n127:         print(f\"runtime exe missing: {exe}\")\n128:         print(\"build first: cargo build --release --manifest-path apps/desktop/src-tauri/Cargo.toml\")\n129:         return 2\n130: \n131:     manifest = prepare_lab()\n132:     exit_code, results_path, _ = run_probe(exe, manifest)\n133:     if results_path is None:\n134:         print(\"no results produced\")\n135:         return 1\n136: \n137:     results = json.loads(results_path.read_text(encoding=\"utf-8\"))\n138:     statuses: dict[str, int] = {}\n139:     for record in results[\"results\"]:\n140:         status = record.get(\"status\", \"MISSING\")\n141:         statuses[status] = statuses.get(status, 0) + 1\n142:         print(f\"{record.get('id', '?'):40s} {status}\")\n143:     print(\"summary:\", statuses)\n144:     print(f\"results: {results_path}\")\n145:     # R-03: NOT_RUN is a gate failure, not a pass — the runner must be able\n146:     # to tell \"scenario did not run\" apart from \"scenario passed\"\n147:     failed = (\n148:         statuses.get(\"FAIL\", 0)\n149:         + statuses.get(\"MISSING\", 0)\n150:         + statuses.get(\"NOT_RUN\", 0)\n151:     )\n152:     return 0 if exit_code == 0 and failed == 0 else 1\n153: \n154: \n155: if __name__ == \"__main__\":\n156:     sys.exit(main())\n\n(End of file - total 156 lines)\n</content>"}
