{"type":"tool_result","callId":"call_00_ecz8qYu6wJrIbUKNTqCs4054","status":"completed","result":"<path>G:\\CODEX\\New Manga.worktrees\\M2-RC1-zcode\\verification\\M2-RC1\\compare_e2e_runs.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Compare two run_e2e.py result JSONs and emit a consistency artefact.\n2: \n3: R-03: the previous fix-repeat-consistency.json claimed ``differences: {}``\n4: with no generator. This script IS the generator; it reports real\n5: observed-layer differences and classifies them against an explicit\n6: whitelist of nondeterministic fields, so ``consistent`` means exactly:\n7: identical id+status sets AND observed differences only in whitelisted\n8: timing/randomness fields.\n9: \n10: Usage:\n11:   python compare_e2e_runs.py FIRST.json REPEAT.json OUT.json\n12: \"\"\"\n13: \n14: from __future__ import annotations\n15: \n16: import json\n17: import sys\n18: from pathlib import Path\n19: \n20: # Fields whose values legitimately differ between two runs of the same\n21: # binary+fixtures: E-06 mints fresh random references per run; E-07 is a\n22: # wall-clock timing measurement.\n23: NONDETERMINISTIC = {\n24:     \"E-06-remount-fresh-references\": {\"observed\"},\n25:     \"E-07-per-reference-first-byte-p95\": {\"observed.p95_ms\", \"observed.timings_ms\"},\n26:     # pre-rename id (historical rounds)\n27:     \"E-07-hot-cache-p95\": {\"observed.p95_ms\", \"observed.timings_ms\"},\n28: }\n29: \n30: \n31: def flatten(record: dict, prefix: str = \"\") -> dict:\n32:     flat: dict = {}\n33:     for key, value in record.items():\n34:         path = f\"{prefix}.{key}\" if prefix else key\n35:         if isinstance(value, dict):\n36:             flat.update(flatten(value, path))\n37:         else:\n38:             flat[path] = value\n39:     return flat\n40: \n41: \n42: def main() -> int:\n43:     first_path, repeat_path, out_path = (Path(a) for a in sys.argv[1:4])\n44:     first = json.loads(first_path.read_text(encoding=\"utf-8\"))\n45:     repeat = json.loads(repeat_path.read_text(encoding=\"utf-8\"))\n46: \n47:     def by_id(results: list[dict]) -> dict[str, dict]:\n48:         return {r[\"id\"]: r for r in results}\n49: \n50:     first_map, repeat_map = by_id(first[\"results\"]), by_id(repeat[\"results\"])\n51:     ids_first, ids_repeat = set(first_map), set(repeat_map)\n52: \n53:     status_differences = [\n54:         {\"id\": i, \"first\": first_map[i].get(\"status\"), \"repeat\": repeat_map[i].get(\"status\")}\n55:         for i in sorted(ids_first & ids_repeat)\n56:         if first_map[i].get(\"status\") != repeat_map[i].get(\"status\")\n57:     ]\n58:     ids_missing_in_repeat = sorted(ids_first - ids_repeat)\n59:     ids_missing_in_first = sorted(ids_repeat - ids_first)\n60: \n61:     observed_differences: list[dict] = []\n62:     unclassified: list[dict] = []\n63:     for scenario_id in sorted(ids_first & ids_repeat):\n64:         flat_a = flatten(first_map[scenario_id])\n65:         flat_b = flatten(repeat_map[scenario_id])\n66:         for field in sorted(set(flat_a) | set(flat_b)):\n67:             value_a, value_b = flat_a.get(field), flat_b.get(field)\n68:             if value_a == value_b:\n69:                 continue\n70:             entry = {\n71:                 \"id\": scenario_id,\n72:                 \"field\": field,\n73:                 \"first\": value_a,\n74:                 \"repeat\": value_b,\n75:             }\n76:             whitelist = NONDETERMINISTIC.get(scenario_id, set())\n77:             observed_differences.append(entry)\n78:             if field not in whitelist and not any(\n79:                 field.startswith(w + \".\") or w.startswith(field) for w in whitelist\n80:             ):\n81:                 unclassified.append(entry)\n82: \n83:     consistent = (\n84:         not status_differences\n85:         and not ids_missing_in_repeat\n86:         and not ids_missing_in_first\n87:         and not unclassified\n88:     )\n89:     report = {\n90:         \"generator\": \"verification/M2-RC1/compare_e2e_runs.py\",\n91:         \"first\": first_path.name,\n92:         \"repeat\": repeat_path.name,\n93:         \"first_status_counts\": {\n94:             s: sum(1 for r in first[\"results\"] if r.get(\"status\") == s)\n95:             for s in {r.get(\"status\") for r in first[\"results\"]}\n96:         },\n97:         \"repeat_status_counts\": {\n98:             s: sum(1 for r in repeat[\"results\"] if r.get(\"status\") == s)\n99:             for s in {r.get(\"status\") for r in repeat[\"results\"]}\n100:         },\n101:         \"status_differences\": status_differences,\n102:         \"ids_missing_in_repeat\": ids_missing_in_repeat,\n103:         \"ids_missing_in_first\": ids_missing_in_first,\n104:         \"observed_differences\": observed_differences,\n105:         \"unclassified_differences\": unclassified,\n106:         \"nondeterministic_whitelist\": {\n107:             k: sorted(v) for k, v in sorted(NONDETERMINISTIC.items())\n108:         },\n109:         # \"consistent\" = id+status identical AND every observed difference is\n110:         # a whitelisted timing/randomness field (NOT \"no differences\")\n111:         \"consistent\": consistent,\n112:     }\n113:     out_path.write_text(json.dumps(report, indent=2) + \"\\n\", encoding=\"utf-8\")\n114:     print(f\"consistent={consistent} -> {out_path}\")\n115:     return 0 if consistent else 1\n116: \n117: \n118: if __name__ == \"__main__\":\n119:     sys.exit(main())\n\n(End of file - total 119 lines)\n</content>"}
{"type":"tool_result","callId":"call_01_JQvcx2FECmTYVH03cLJp3215","status":"completed","result":"<path>G:\\CODEX\\New Manga.worktrees\\M2-RC1-zcode\\verification\\M2-RC1\\leakage_scan.py</path>\n<type>file</type>\n<content>\n1: \"\"\"Scan e2e result JSONs for caller-visible leakage fragments.\n2: \n3: R-03 companion: leakage-scan.json previously had no generator. This script\n4: IS the generator — rerunnable over any set of result files with the same\n5: fragment list, so the artefact can be recomputed from the raw inputs.\n6: \n7: Usage:\n8:   python leakage_scan.py OUT.json FILE.json [FILE.json ...]\n9: \"\"\"\n10: \n11: from __future__ import annotations\n12: \n13: import json\n14: import sys\n15: from pathlib import Path\n16: \n17: FRAGMENTS = [\n18:     \"49745\",  # user id fragment (C:\\\\Users\\\\49745)\n19:     \"C:\\\\Users\",\n20:     \"AppData\",\n21:     \"m2rc1-lab\",  # lab scope root directory name\n22:     \"asset.png\",\n23:     \"typical.png\",\n24:     \"boundary.bin\",\n25:     \"oversize.bin\",\n26:     \"scope\\\\derived\",\n27: ]\n28: \n29: # A hit is acceptable only when the fragment comes from probe-authored\n30: # scenario labels written by the page itself; the product command face\n31: # (issue_resource_url) never returns an OS path or digest.\n32: PROBE_LABEL_NOTE = (\n33:     \"probe-authored scenario label written by the page itself, not \"\n34:     \"host-served material; the product command face (issue_resource_url) \"\n35:     \"never returns a path\"\n36: )\n37: \n38: \n39: def main() -> int:\n40:     out_path = Path(sys.argv[1])\n41:     files = [Path(a) for a in sys.argv[2:]]\n42:     hits = []\n43:     for path in files:\n44:         text = path.read_text(encoding=\"utf-8\", errors=\"replace\")\n45:         for fragment in FRAGMENTS:\n46:             start = 0\n47:             while True:\n48:                 index = text.find(fragment, start)\n49:                 if index < 0:\n50:                     break\n51:                 hits.append(\n52:                     {\n53:                         \"file\": path.name,\n54:                         \"fragment\": fragment,\n55:                         \"context\": text[max(0, index - 40) : index + 40],\n56:                         \"classification\": PROBE_LABEL_NOTE\n57:                         if fragment in (\"asset.png\", \"typical.png\", \"boundary.bin\", \"oversize.bin\")\n58:                         else \"UNCLASSIFIED\",\n59:                     }\n60:                 )\n61:                 start = index + len(fragment)\n62:     report = {\n63:         \"generator\": \"verification/M2-RC1/leakage_scan.py\",\n64:         \"files\": [p.name for p in files],\n65:         \"fragments_checked\": FRAGMENTS,\n66:         \"hits\": hits,\n67:         \"unclassified_hits\": [h for h in hits if h[\"classification\"] == \"UNCLASSIFIED\"],\n68:     }\n69:     out_path.write_text(json.dumps(report, indent=2) + \"\\n\", encoding=\"utf-8\")\n70:     clean = not report[\"unclassified_hits\"]\n71:     print(f\"hits={len(hits)} unclassified={len(report['unclassified_hits'])} -> {out_path}\")\n72:     return 0 if clean else 1\n73: \n74: \n75: if __name__ == \"__main__\":\n76:     sys.exit(main())\n\n(End of file - total 76 lines)\n</content>"}
