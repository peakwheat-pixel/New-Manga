{"type":"tool_result","callId":"call_00_CivRfTgdj5Bca5UnfUoB5125","status":"completed","result":"<path>G:\\CODEX\\New Manga.worktrees\\M2-RC1-zcode\\apps\\desktop\\frontend\\src\\resourceChannel\\client.test.ts</path>\n<type>file</type>\n<content>\n1: import { describe, expect, it, vi } from \"vitest\";\n2: import { ResourceChannelClient, chunkCount, parseTypedCode } from \"./client\";\n3: \n4: function makeInvoke() {\n5:   const revoked = new Set<string>();\n6:   const invoke = vi.fn(async (command: string, args?: Record<string, unknown>) => {\n7:     if (command === \"issue_resource_url\") {\n8:       // exact convention: m2id.v1.<43-char segment> (8 + 43 = 51 chars)\n9:       const segment = (Math.random().toString(36).slice(2) + Date.now().toString(36))\n10:         .padEnd(43, \"0\")\n11:         .slice(0, 43)\n12:         .replace(/[^A-Za-z0-9_-]/g, \"0\");\n13:       const opaque = `m2id.v1.${segment}`;\n14:       // build_url serves only the 43-char segment in the path, never the\n15:       // prefixed opaque id (R-05)\n16:       return { url: `http://m2res.localhost/m2id/${segment}`, size: 1024, opaque_id: opaque };\n17:     }\n18:     if (command === \"revoke_ref\") {\n19:       revoked.add(String(args?.opaqueId));\n20:       return null;\n21:     }\n22:     throw new Error(`unexpected command ${command}`);\n23:   });\n24:   return { invoke, revoked };\n25: }\n26: \n27: describe(\"chunkCount\", () => {\n28:   it(\"rounds partial chunks up\", () => {\n29:     expect(chunkCount(0)).toBe(0);\n30:     expect(chunkCount(1)).toBe(1);\n31:     expect(chunkCount(16 * 1024 * 1024)).toBe(1);\n32:     expect(chunkCount(16 * 1024 * 1024 + 1)).toBe(2);\n33:   });\n34: });\n35: \n36: describe(\"parseTypedCode\", () => {\n37:   it(\"extracts the stable code from a typed error body\", () => {\n38:     expect(parseTypedCode(410, '{\"code\":\"REF_REVOKED\"}')).toBe(\"REF_REVOKED\");\n39:   });\n40:   it(\"returns null for successful statuses\", () => {\n41:     expect(parseTypedCode(200, \"\")).toBeNull();\n42:   });\n43:   it(\"falls back to REF_MALFORMED when the body is not typed JSON\", () => {\n44:     expect(parseTypedCode(500, \"boom\")).toBe(\"REF_MALFORMED\");\n45:   });\n46: });\n47: \n48: describe(\"ResourceChannelClient\", () => {\n49:   it(\"issues a reference and exposes only the opaque URL and size\", async () => {\n50:     const { invoke } = makeInvoke();\n51:     const client = new ResourceChannelClient(invoke);\n52:     const issued = await client.issue(\"res-001\", \"rev-1\");\n53:     expect(issued.url.startsWith(\"http://m2res.localhost/m2id/\")).toBe(true);\n54:     expect(issued.size).toBe(1024);\n55:     // wire shape pinned: opaque id = \"m2id.v1.\" + 43-char segment (51 chars);\n56:     // the URL path carries only the segment, never the prefixed form (R-05)\n57:     expect(issued.opaqueId).toMatch(/^m2id\\.v1\\.[A-Za-z0-9_-]{43}$/);\n58:     expect(issued.opaqueId.length).toBe(51);\n59:     expect(issued.url.slice(\"http://m2res.localhost/m2id/\".length)).toMatch(\n60:       /^[A-Za-z0-9_-]{43}$/,\n61:     );\n62:     // no path/digest/revision fingerprint ever crosses the WebView boundary\n63:     expect(JSON.stringify(issued)).not.toMatch(/C:\\\\|asset\\.png|sha256|rev-1/);\n64:   });\n65: \n66:   it(\"fetches all chunks and assembles the blob\", async () => {\n67:     const { invoke } = makeInvoke();\n68:     const client = new ResourceChannelClient(invoke);\n69:     const issued = await client.issue(\"res-001\", \"rev-1\");\n70:     const fetchMock = vi.fn(async (url: string) => {\n71:       expect(url.startsWith(issued.url)).toBe(true);\n72:       return new Response(new Uint8Array(1024), { status: 200 });\n73:     });\n74:     const blob = await client.fetchAll(issued.url, issued.size, fetchMock as unknown as typeof fetch);\n75:     expect(blob.size).toBe(1024);\n76:     expect(fetchMock).toHaveBeenCalledTimes(1);\n77:   });\n78: \n79:   it(\"surfaces typed rejection codes from the protocol\", async () => {\n80:     const { invoke } = makeInvoke();\n81:     const client = new ResourceChannelClient(invoke);\n82:     const issued = await client.issue(\"res-001\", \"rev-1\");\n83:     await client.revoke(issued.opaqueId);\n84:     const fetchMock = vi.fn(async () =>\n85:       new Response('{\"code\":\"REF_REVOKED\"}', { status: 410 })\n86:     );\n87:     await expect(\n88:       client.fetchAll(issued.url, issued.size, fetchMock as unknown as typeof fetch)\n89:     ).rejects.toMatchObject({ code: \"REF_REVOKED\" });\n90:   });\n91: \n92:   it(\"never reuses a stale URL after remount (fresh issue per mount)\", async () => {\n93:     const { invoke } = makeInvoke();\n94:     const client = new ResourceChannelClient(invoke);\n95:     const first = await client.issue(\"res-001\", \"rev-1\");\n96:     const second = await client.issue(\"res-001\", \"rev-1\");\n97:     expect(first.opaqueId).not.toBe(second.opaqueId);\n98:     expect(first.url).not.toBe(second.url);\n99:   });\n100: });\n\n(End of file - total 100 lines)\n</content>"}
{"type":"tool_result","callId":"call_01_X9kucHgVfLERRiCLybVX6905","status":"completed","result":"<path>G:\\CODEX\\New Manga.worktrees\\M2-RC1-zcode\\apps\\desktop\\src-tauri\\src\\resource_protocol.rs</path>\n<type>file</type>\n<content>\n1: //! The `m2res` custom URI scheme protocol (M2-RC1).\n2: //!\n3: //! URL form (Windows/WebView2): `http://m2res.localhost/m2id/<opaque-id>?chunk=<n>`\n4: //!\n5: //! Serving pipeline per request (RC1-AC4, M2-S2 semantics productised):\n6: //! 1. opaque-ID format gate (43-char base64url) — malformed before any lookup;\n7: //! 2. EVERY request resolves via the Core control bridge before the grant\n8: //!    cache is consulted (F-01): a Core rejection evicts the cached entry and\n9: //!    propagates typed errors (REF_UNKNOWN_ID / REF_REVOKED / REF_EXPIRED);\n10: //! 3. open the target **once** (GENERIC_READ / FILE_SHARE_READ /\n11: //!    FILE_FLAG_BACKUP_SEMANTICS) and verify **from that handle**: containment\n12: //!    (final path re-derived from the handle stays inside the scope root),\n13: //!    file identity (volume serial + file index vs issue-time facts), size\n14: //!    (issue-time size + T1 256 MiB limit);\n15: //! 4. the issue-time digest is re-verified through the handle whenever the\n16: //!    grant has never been verified OR its LastWriteTime moved since the last\n17: //!    verification (F-02: catches equal-size in-place rewrites) without\n18: //!    materialising the file;\n19: //! 5. serve the requested chunk (≤16 MiB) read through the same handle;\n20: //! 6. re-check identity after reading.\n21: //!\n22: //! Responses are always `Cache-Control: no-store` (revocation must never be\n23: //! served from a cache; the M2-S3 probe measured the bypass contrast) and\n24: //! carry permissive CORS so the `tauri.localhost` page may fetch them.\n25: //! Errors are stable typed codes in a JSON body; no OS path, mapping-table\n26: //! entry, revision fingerprint or digest ever appears in a response.\n27: \n28: use crate::core_bridge::{CoreChannel, CoreError, Grant};\n29: use serde_json::json;\n30: use sha2::{Digest as ShaDigest, Sha256};\n31: use std::collections::HashMap;\n32: use std::path::PathBuf;\n33: use std::sync::Mutex;\n34: \n35: pub const SCHEME_HOST: &str = \"m2res.localhost\";\n36: pub const CHUNK_SIZE: u64 = 16 * 1024 * 1024; // T4: resident buffer ≤ 32 MiB\n37: pub const MAX_RESOURCE_BYTES: u64 = 256 * 1024 * 1024; // T1 commitment line\n38: pub const ID_LENGTH: usize = 43; // base64url of 32 random bytes\n39: \n40: const GENERIC_READ: u32 = 0x8000_0000;\n\n(Showing lines 1-40 of 570. Use offset=41 to continue.)\n</content>"}
