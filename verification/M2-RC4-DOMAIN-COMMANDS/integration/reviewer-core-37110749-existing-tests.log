tmp_path = WindowsPath('C:/Users/49745/AppData/Local/Temp/pytest-of-49745/pytest-970/test_real_subprocess_e2e_round0')

    def test_real_subprocess_e2e_round_trip(tmp_path: Path) -> None:
        """AC4 discriminating test: spawns real subprocess and tests request/response."""
        data_root = tmp_path / "data_e2e"
        data_root.mkdir(parents=True, exist_ok=True)
    
        repo_root = Path(__file__).resolve().parents[2]
        src_root = repo_root / "src"
    
        env = os.environ.copy()
        # DSH r1 R5: keep the e2e hermetic -- a host-level detector env must
        # never turn this subprocess into a real model load (the NOT_CONFIGURED
        # assertion below would then fail or hang on weights resolution).
        env.pop("NEWMANGA_DETECTOR_WEIGHTS", None)
        env.pop("NEWMANGA_DETECTOR_BACKEND", None)
        env["NEWMANGA_DATA_ROOT"] = str(data_root)
        env["PYTHONPATH"] = str(src_root)
        env["PYTHONDONTWRITEBYTECODE"] = "1"
    
        proc = subprocess.Popen(
            [sys.executable, "-m", "bootstrap.core_service"],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            bufsize=1,
            env=env,
            cwd=str(repo_root),
        )
    
        def send_and_recv(cmd_obj: dict) -> dict:
            line = json.dumps(cmd_obj) + "\n"
            proc.stdin.write(line)  # type: ignore[union-attr]
            proc.stdin.flush()  # type: ignore[union-attr]
            resp_line = proc.stdout.readline()  # type: ignore[union-attr]
            return json.loads(resp_line)
    
        try:
