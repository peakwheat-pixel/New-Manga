from io import BytesIO
from PIL import Image
from infrastructure.rendering.pillow_rendering import PillowFontCatalog, PillowImageCompositor, PillowTextLayoutEngine
from ports.rendering.ports import LayoutRequest, RenderOp
from ports.rendering.direction import TextDirection
catalog = PillowFontCatalog(); layout = PillowTextLayoutEngine(catalog); compositor = PillowImageCompositor(catalog)
base = BytesIO(); Image.new('RGB', (240, 160), 'white').save(base, format='PNG')
for direction, text in ((TextDirection.HORIZONTAL, 'HELLO WORLD\nSECOND LINE'), (TextDirection.VERTICAL, '縦書き文字')):
    request = LayoutRequest(text, 'Arial', 24, direction, 180, 120, 2, 1.0)
    result = layout.layout(request)
    op = RenderOp(result.items, 10, 10, 180, 120, result.resolved_family, 24, '#000000', True, '#FFFFFF', 2, direction, 'center')
    image = Image.open(BytesIO(compositor.compose_page(base.getvalue(), (op,)))).convert('RGB')
    dark = sum(1 for pixel in image.getdata() if max(pixel) < 100)
    print(direction.value, 'fits=', result.fits, 'items=', len(result.items), 'dark_pixels=', dark, 'font_available=', result.font_available)
