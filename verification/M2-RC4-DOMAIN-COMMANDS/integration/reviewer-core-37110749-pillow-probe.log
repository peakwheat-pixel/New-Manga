from dataclasses import replace
from io import BytesIO
from PIL import Image
from infrastructure.rendering.pillow_rendering import PillowFontCatalog, PillowImageCompositor
from ports.rendering.ports import DrawItem, RenderOp
from ports.rendering.direction import TextDirection
catalog = PillowFontCatalog()
compositor = PillowImageCompositor(catalog)
image = Image.new('RGB', (200, 100), 'white')
for y in range(100):
    for x in range(50): image.putpixel((x, y), (255, 0, 0))
buffer = BytesIO(); image.save(buffer, format='PNG')
base = buffer.getvalue()
op = RenderOp((DrawItem('T', 0, 30),), 50, 10, 100, 70, 'Arial', 26, '#000000', True, '#FFFFFF', 3, TextDirection.HORIZONTAL, 'start')
result = Image.open(BytesIO(compositor.compose_page(base, (op,)))).convert('RGB')
changed = [(x,y) for y in range(10,80) for x in range(40,50) if result.getpixel((x,y)) != (255,0,0)]
print('adjacent_nonoverlap_skip_pixels_changed=', len(changed), 'examples=', changed[:8])
for align in ('start','center','end'):
    aligned = Image.open(BytesIO(compositor.compose_page(base, (replace(op, stroke_enabled=False, text_align=align),)))).convert('RGB')
    ink = [(x,y) for y in range(100) for x in range(50,200) if aligned.getpixel((x,y)) == (0,0,0)]
    print('align=', align, 'ink_min_x=', min(x for x,y in ink), 'ink_max_x=', max(x for x,y in ink))
PYTHON_CODE_END
