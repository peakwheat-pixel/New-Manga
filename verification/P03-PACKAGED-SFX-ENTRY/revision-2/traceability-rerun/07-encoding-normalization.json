  "grammar_specification": {
    "description": "Formal grammar defining the mixed-encoding body byte stream and its bijective mapping to canonical UTF-8",
    "encoding_mixed_explanation": "Observed objective token structure in raw captures: UTF-8 header and footer enclosing a body consisting of [c, 0x00] (UTF-16LE ASCII units) and newline sequence 0D 0A 00 0D 0A 00. Mixed encoding directly stems from PowerShell 5.1 Out-File and Tee-Object usage; specific internal mechanism producing the expanded newline sequence is unverified.",
    "segments": {
      "header": "UTF-8-SIG bytes from start to separator =====================================\\r\\n",
      "body": "Token stream between header separator and footer separator =====================================\\r\\nEndTime:",
      "footer": "UTF-8 bytes from footer separator to file EOF"
    },
    "tokens": {
      "CHAR_TOKEN": {
        "raw_byte_pattern": "[0x00-0x7F, 0x00] excluding CR/LF in byte 0",
        "raw_byte_length": 2,
        "interpretation": "Standard UTF-16LE encoding of single-byte ASCII characters",
        "forward_canonical_mapping": "Single byte c (UTF-8 ASCII)",
        "inverse_mapping": "bytes([c, 0])"
      },
      "NEWLINE_TOKEN": {
        "raw_byte_pattern": "0x0D 0x0A 0x00 0x0D 0x0A 0x00 (hex: 0d 0a 00 0d 0a 00)",
        "raw_byte_length": 6,
        "interpretation": "Expanded newline sequence in raw captures (under raw UTF-16LE decoding interpreted as U+0A0D U+0D00 U+000A)",
        "forward_canonical_mapping": "\\r\\n\\r\\n (hex: 0d 0a 0d 0a, CRLF CRLF, 4 bytes)",
        "inverse_mapping": "b'\\r\\n\\x00\\r\\n\\x00' (6 bytes)"
      },
      "TRAILING_SPACE_TOKEN": {
        "raw_byte_pattern": "0x20 0x00 0x0D 0x0A 0x00 0x0D 0x0A 0x00 (hex: 20 00 0d 0a 00 0d 0a 00)",
        "raw_byte_length": 8,
        "interpretation": "UTF-16LE ASCII space (0x20 0x00) immediately preceding a NEWLINE_TOKEN, representing trailing whitespace at line end in raw output stream",
        "forward_canonical_mapping": "U+2420 SYMBOL FOR SPACE (␠, UTF-8 hex: e2 90 a0) followed by \\r\\n\\r\\n",
        "inverse_mapping": "b' \\x00\\r\\n\\x00\\r\\n\\x00' (8 bytes)",
        "escape_character_assertion": "U+2420 does not appear anywhere in raw captured body text; bijective and unambiguous"
      }
    },
    "transform_properties": {
      "deterministic": true,
      "bijective": true,
      "information_loss": false,
      "lossless_reconstruction_verified": true,
      "git_whitespace_check_clean": true
    }
