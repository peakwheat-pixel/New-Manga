 903:     def retry_failed_targets(self, run_id: str) -> PipelineRun:
 904:         run = self._require_run(run_id)
 905:         failed_pages = tuple(
 906:             dict.fromkeys(
 907:                 task.page_id
 908:                 for task in run.tasks
 909:                 if task.status is PipelineTaskStatus.FAILED and task.target_type is TargetType.PAGE
 910:             )
 911:         )
 912:         if not failed_pages:
 913:             raise PipelineError("TARGET_NOT_FOUND", "run has no failed page targets")
 914:         return self.create_run(
 915:             run.command_type,
 916:             PipelineScope(ScopeType.PAGE_SELECTION, selected_ids=failed_pages),

=== transition gates inside control_run ===
  PENDING                          -> 4 hit(s)
  RUNNING                          -> 1 hit(s)
  PAUSED                           -> 3 hit(s)
  INTERRUPTED                      -> 5 hit(s)
  completed_with_failures          -> 0 hit(s)
  INVALID_RUN_TRANSITION           -> 4 hit(s)
  abandoned_after_interruption     -> 1 hit(s)
  restarted                        -> 1 hit(s)
  retry_reason                     -> 1 hit(s)
  source_run_id                    -> 1 hit(s)
