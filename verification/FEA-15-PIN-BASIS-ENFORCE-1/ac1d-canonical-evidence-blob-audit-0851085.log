PYTHON_SOURCE_BEGIN
import hashlib
import pathlib
import subprocess
import sys

task = pathlib.Path("doc/tasks/FEA-15-PIN-BASIS-ENFORCE-1.md")
rows = [line for line in task.read_text(encoding="utf-8").splitlines() if line.startswith("| ac")]
failures = 0
print(f"CANONICAL_ROW_COUNT={len(rows)}")
for line in rows:
    cells = line.split("|")
    evidence_id, path, commit, pin = (cells[i].strip() for i in (1, 3, 4, 5))
    result = subprocess.run(["git", "cat-file", "blob", f"{commit}:{path}"], capture_output=True)
    blob_hash = hashlib.sha256(result.stdout).hexdigest() if result.returncode == 0 else "MISSING"
    ok = result.returncode == 0 and blob_hash == pin.lower()
    print(f"ROW={evidence_id} COMMIT_HAS_PATH={result.returncode == 0} BLOB_SHA_MATCH={ok} SHA256={blob_hash} PIN={pin.lower()}")
    failures += int(not ok)
print(f"PIN_AUDIT={'PASS' if failures == 0 else 'FAIL'} failures={failures}")
sys.exit(int(failures != 0))
PYTHON_SOURCE_END
