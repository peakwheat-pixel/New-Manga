diff --git a/apps/desktop-avalonia/src/NewManga.CoreClient/CoreServiceClient.cs b/apps/desktop-avalonia/src/NewManga.CoreClient/CoreServiceClient.cs
index 0e3014f17..b38485fc7 100644
--- a/apps/desktop-avalonia/src/NewManga.CoreClient/CoreServiceClient.cs
+++ b/apps/desktop-avalonia/src/NewManga.CoreClient/CoreServiceClient.cs
@@ -2456,22 +2456,39 @@ public sealed class CoreServiceClient : IAsyncDisposable
     }
 
     /// <summary>
-    /// A response belongs to the request when it carries no request id at all (the frozen core omits it on
-    /// some frames) or when the id matches exactly. A DIFFERENT id is what R-002 is about.
+    /// A response belongs to the request only when it carries that exact request id.
+    ///
+    /// <para><b>E-7 #2 — fail-closed (Codex ruling 2026-11-16).</b> This used to treat "no request_id"
+    /// as belonging to the request (fail-open). The ruling rejected that for the production path: holding
+    /// the exchange lease only proves the pipe is used serially, it does NOT prove the response belongs to
+    /// this command — a damaged response, a duplicate frame, or a resync that stopped early all still land
+    /// in the caller's hands under fail-open. Event frames are already excluded upstream by
+    /// <c>CoreProtocol.IsEventFrame</c>, so they do not need the leniency either.</para>
+    ///
+    /// <para><c>SendRawAsync</c> deliberately does NOT go through this method: it is the raw-wire
+    /// observation hook and keeps "return whatever came back" semantics (ruling: no new opt-out switch).</para>
+    ///
+    /// <para>Consequence accepted by the ruling: a response that genuinely lacks an id (the frozen core
+    /// emits <c>request_id: null</c> for requests that did not supply one) is now treated as a mismatched
+    /// frame — it is discarded by the bounded resync and, if no matching frame arrives within the budget,
+    /// the channel is poisoned instead of silently handing over an unverifiable payload.</para>
     /// </summary>
-    private static bool BelongsToRequest(CoreResponse response, string requestId) =>
-        response.RequestId is not { } actual || string.Equals(actual, requestId, StringComparison.Ordinal);
+    internal static bool BelongsToRequest(CoreResponse response, string requestId) =>
+        response.RequestId is { } actual && string.Equals(actual, requestId, StringComparison.Ordinal);
 
     internal static void EnsureResponseBelongsToRequest(
         CoreResponse response, string requestId, string? stderrLogPath)
     {
-        if (response.RequestId is { } actual && !string.Equals(actual, requestId, StringComparison.Ordinal))
+        // E-7 #2 (Codex ruling 2026-11-16 §5.1): if this judge is kept it MUST reuse the same strict
+        // predicate as production -- it used to let a null request_id through, which contradicted the
+        // fail-closed policy for exactly the same case.
+        if (!BelongsToRequest(response, requestId))
         {
             throw new SidecarException(
                 SidecarErrorCode.MalformedResponse,
                 SidecarSpec.CoreServiceName,
-                $"response request_id '{actual}' does not match request '{requestId}': "
-                + "the core pipe returned another command's response",
+                $"response request_id '{response.RequestId ?? "<missing>"}' does not match request "
+                + $"'{requestId}': the core pipe returned another command's response",
                 stderrLogPath);
         }
     }
diff --git a/apps/desktop-avalonia/tests/NewManga.CoreClient.Tests/Commands/PipeResponsePairingValidationTests.cs b/apps/desktop-avalonia/tests/NewManga.CoreClient.Tests/Commands/PipeResponsePairingValidationTests.cs
index ecf05d313..41552007c 100644
--- a/apps/desktop-avalonia/tests/NewManga.CoreClient.Tests/Commands/PipeResponsePairingValidationTests.cs
+++ b/apps/desktop-avalonia/tests/NewManga.CoreClient.Tests/Commands/PipeResponsePairingValidationTests.cs
@@ -50,17 +50,59 @@ public sealed class PipeResponsePairingValidationTests
     }
 
     /// <summary>
-    /// Known limitation (r1 复核 R-001): a frame WITHOUT a request_id currently passes the check
-    /// (fail-open). This fact documents the current behaviour so that any future change to fail-closed
-    /// has to update it deliberately rather than silently.
+    /// E-7 #2 (Codex ruling 2026-11-16 §5.1/§5.3): this used to document fail-open for a frame WITHOUT a
+    /// request_id. The ruling made the production predicate strict and requires the kept judge to reuse it,
+    /// so a missing id is now a typed rejection instead of being accepted.
     /// </summary>
     [Fact]
-    public void MissingRequestId_CurrentlyFailsOpen_DocumentedLimitation()
+    public void MissingRequestId_ThrowsTypedMalformedResponse()
     {
         var response = CoreProtocol.Parse(
             "{\"protocol\":\"new-manga.core\",\"version\":{\"major\":2,\"minor\":3},\"result\":[],\"error\":null}");
 
         Assert.Null(response.RequestId);
-        CoreServiceClient.EnsureResponseBelongsToRequest(response, "req-1", stderrLogPath: null);
+
+        var error = Assert.Throws<SidecarException>(
+            () => CoreServiceClient.EnsureResponseBelongsToRequest(response, "req-1", stderrLogPath: null));
+
+        Assert.Equal(SidecarErrorCode.MalformedResponse, error.Code);
+        Assert.Contains("<missing>", error.Message, StringComparison.Ordinal);
+    }
+
+    /// <summary>
+    /// E-7 #2 裁决 §5.3: every non-string shape of request_id must be rejected, not just the missing key.
+    /// (The parser maps all of these to a null RequestId.)
+    /// </summary>
+    [Theory]
+    [InlineData("null")]
+    [InlineData("123")]
+    [InlineData("true")]
+    [InlineData("{}")]
+    [InlineData("[]")]
+    [InlineData("\"\"")]
+    public void NonStringOrEmptyRequestId_ThrowsTypedMalformedResponse(string requestIdJson)
+    {
+        var response = CoreProtocol.Parse(
+            "{\"protocol\":\"new-manga.core\",\"version\":{\"major\":2,\"minor\":3},\"request_id\":"
+            + requestIdJson + ",\"result\":[],\"error\":null}");
+
+        // "" parses as an empty STRING (not null) and therefore fails the equality check; the others
+        // parse as null and fail the "must be present" part of the strict predicate. Both are rejections.
+        var error = Assert.Throws<SidecarException>(
+            () => CoreServiceClient.EnsureResponseBelongsToRequest(response, "req-1", stderrLogPath: null));
+
+        Assert.Equal(SidecarErrorCode.MalformedResponse, error.Code);
+    }
+
+    /// <summary>
+    /// The strict predicate itself (shared by the production resync path and the kept judge) must agree
+    /// with the judge for the same inputs.
+    /// </summary>
+    [Fact]
+    public void BelongsToRequest_IsStrict_ForMissingAndMismatchedIds()
+    {
+        Assert.False(CoreServiceClient.BelongsToRequest(CoreProtocol.Parse("{\"result\":[]}"), "req-1"));
+        Assert.False(CoreServiceClient.BelongsToRequest(ResponseWithId("req-999"), "req-1"));
+        Assert.True(CoreServiceClient.BelongsToRequest(ResponseWithId("req-1"), "req-1"));
     }
 }
diff --git a/apps/desktop-avalonia/tests/NewManga.CoreClient.Tests/R002ResyncTests.cs b/apps/desktop-avalonia/tests/NewManga.CoreClient.Tests/R002ResyncTests.cs
