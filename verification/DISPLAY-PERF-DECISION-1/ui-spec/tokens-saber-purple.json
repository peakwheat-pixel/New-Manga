  "avalonia": {
    "resourceStrategy": "浅色值放 ResourceDictionary 顶层（ThemeVariant.Light 默认），深色放 <ResourceDictionary.ThemeDictionaries><ResourceDictionary x:Key='Dark'>…。界面统一用 {DynamicResource NmAccent} 之类键，禁止写死颜色。",
    "keyMapping": "nm-bg-canvas → NmBgCanvas；nm-accent → NmAccent；连字符去掉并转 PascalCase。",
    "gradient": "135deg 线性渐变映射为 <LinearGradientBrush StartPoint='0%,0%' EndPoint='100%,100%'>（Avalonia RelativePoint），stops 取 gradient.stops。",
    "color": "Color.Parse(\"#AARRGGBB\") 可直接用；Brush 建议 SolidColorBrush 与 LinearGradientBrush 各建资源，避免运行时字符串解析。",
    "shadow": "Avalonia Border.BoxShadow 语法：\"offsetX offsetY blur spread color\"；JSON 中 offsetY/blur/color 直接拼接为 \"0 {offsetY} {blur} 0 {color}\"（x 偏移为 0）。卡片等多层阴影用逗号分隔。",
    "cornerRadius": "Border.CornerRadius / Control.CornerRadius 直接取 radius 值（px == DIP）。",
    "font": "FontFamily 取 nm-font-sans；字重通过 FontWeight.SemiBold 等映射 400/500/600/700。",
    "spacing": "Thickness/Margin 取 spacing 标度；行内 gap 用 StackPanel.Spacing 或 Grid 的 RowSpacing/ColumnSpacing。",
    "hoverPress": "用 <Style Selector='Button.c-primary:pointerover /template/ Border#PART_Border'> 设置背景与 Transform；Avalonia 的 hover 选择器为 :pointerover，按下为 :pressed，禁用为 :disabled。",
    "transitions": "Transitions 上挂 BrushTransition / DoubleTransition / TransformOperationsTransition；时长取 motion.nm-duration-*。",
    "focusRing": "用 :focus-visible 叠加一个 3px 外描边 Border 或 BoxShadow \"0 0 0 3 {NmFocusRing}\"。",
    "theming": "App 启动时按用户设置切换 RequestedThemeVariant=Light/Dark（ThemeCenter 占位页只读预览，暂不改全局）。",
    "grid": "书架网格优先 ItemsControl + WrapPanel（按容器宽计算列数并设 ItemWidth），或 Grid + 动态 ColumnDefinitions；Avalonia 无 CSS auto-fill/minmax，列数需在 VM/附加属性里算。",
    "scroll": "统一 ScrollViewer（Overlay 滚动条），滚动条宽度 6–8px，颜色取 nm-border-strong / nm-bg-hover，圆角 999px。",
    "notes": [
      "Avalonia 无 CSS ::before/::after：Saber 用伪元素画的「📚」标题图标、书卡 hover「查看详情」遮罩需改为独立控件（Icon + 可动画 Border）。",
      "禁止把 rgba() 直接塞进 XAML：先换算 #AARRGGBB。",
      "深浅切换时渐变两端都需替换（深色用 #667EEA→#8B6BBF）。"
    ]
  },

  "usageRules": [
    "品牌渐变只用于：顶栏、主按钮、选中/进入类动作、封面占位、搜索按钮；不要用于大面积背景（页面背景用 nm-bg-canvas）。",
    "一张界面最多一个品牌渐变实心按钮（主 CTA）；其余动作用 secondary / icon 按钮。",
    "状态色只表达状态：success=完成/已翻译、danger=删除/失败、warning=需注意/清理、info=中性信息/进度。Saber 工作区把动作按颜色分族（绿=翻译、紫=高质量/AI、蓝=消除、红=删除、橙=清理），这属于「参考」信息架构，不追求其精确色值。",
    "圆角层级：8px 控件 / 12px 卡片与对话框 / 14px 侧栏卡片 / 20px 胶囊 / 999px 圆形；不要混用 6px 与 8px 做同级控件。",
    "阴影克制：默认卡片用 nm-shadow-2；只有 hover/浮层才升到 3/4/5。",
    "文字对比度优先于观感：nm-text-muted 仅用作占位或装饰文字。",
    "字体：界面只用系统字体栈（Microsoft YaHei UI/Segoe UI）；漫画渲染字体另行按可再分发许可引入，禁止从 Saber 安装目录拷入（含商业字体）。"
  ]
}
