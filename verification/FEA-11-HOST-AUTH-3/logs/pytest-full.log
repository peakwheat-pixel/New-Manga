            # M2-REGION-RETYPE-CORE: 2 -> 3 (set_region_type/list_regions added)
            # M2-PAGE-RESOURCE-RESOLVE-1: 4 -> 5 (resolve_page_resource added)
            assert ping_resp["result"]["protocol_version"] == {"major": 2, "minor": 3}
